<% content_for :title, "X Report" %>

<main class="pos-close" data-controller="pos-receipt">
  <div class="pos-no-print">
    <%= render "pos/shared/report_nav" %>

    <p class="pos-banner" role="status"><strong>X REPORT</strong></p>
    <p class="pos-banner" role="status"><strong>INTERIM — SESSION REMAINS OPEN</strong></p>

    <h1>X Report</h1>
    <p>Store  <%= current_store.admin_label %></p>
    <p>Register  <%= @register.admin_label %></p>
    <p>Cashier  <%= @session_record.cashier_user.display_name %></p>
    <p>Business date  <%= @period.business_date.iso8601 %></p>

    <%= render "pos/shared/totals_groups", groups: @report_groups %>

    <div class="pos-close__actions">
      <button type="button" class="btn" data-action="pos-receipt#print">Print</button>
      <%= link_to "Register", pos_path, class: "btn btn--secondary" %>
      <% if @session_record.cashier_user_id == current_user.id %>
        <%= link_to "Resume Register", pos_register_workspace_path(register_id: @register.id), class: "btn" %>
      <% end %>
    </div>
  </div>

  <%= render "pos/shared/report_print",
        title: "X Report",
        banners: [ "X REPORT", "INTERIM — SESSION REMAINS OPEN" ],
        meta: [
          "Store  #{current_store.admin_label}",
          "Register  #{@register.admin_label}",
          "Cashier  #{@session_record.cashier_user.display_name}",
          "Business date  #{@period.business_date.iso8601}"
        ],
        groups: @report_groups %>
</main>
