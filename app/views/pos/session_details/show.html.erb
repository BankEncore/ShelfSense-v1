<% content_for :title, "Session Details" %>
<%= render layout: "pos/shell/frame" do %>
  <%= render "pos/shell/feedback" %>
  <div class="pos-register-shell__body">
    <main class="pos-history">
      <div class="pos-history__title-row pos-no-print">
        <h1>Session Details</h1>
        <%= link_to register_inquiry_return_label, register_inquiry_return_path, class: "btn btn--ghost" %>
      </div>

      <dl class="pos-history__header">
        <div><dt>Register</dt><dd><%= @session_record.register.admin_label %></dd></div>
        <div><dt>Business date</dt><dd><%= @session_record.reporting_period.business_date.iso8601 %></dd></div>
        <div><dt>Cashier</dt><dd><%= @session_record.cashier_user.display_name %></dd></div>
        <div><dt>Status</dt><dd><%= @session_record.status.humanize %></dd></div>
        <div><dt>Opened</dt><dd><%= format_store_timestamp(@session_record.opened_at, current_store) %></dd></div>
        <% if @session_record.closed_at %>
          <div><dt>Closed</dt><dd><%= format_store_timestamp(@session_record.closed_at, current_store) %></dd></div>
        <% end %>
        <div><dt>Opening float</dt><dd><%= format_money_cents(@session_record.opening_float_cents) %></dd></div>
        <div><dt>Transactions</dt><dd><%= @totals.completed_transaction_count %></dd></div>
        <% if @can_view_expected && !@expected_cash_cents.nil? %>
          <div><dt>Expected cash</dt><dd><%= format_money_cents(@expected_cash_cents) %></dd></div>
        <% end %>
        <% if @session_record.closed? && @session_record.closed_by_user %>
          <div><dt>Closed by</dt><dd><%= @session_record.closed_by_user.display_name %></dd></div>
        <% end %>
      </dl>

      <div class="pos-history__nav pos-no-print actions">
        <% if @session_record.open? %>
          <%= link_to "X Report", pos_session_x_report_path(@session_record), class: "btn btn--outline" %>
        <% end %>
        <%= link_to "Till Activity",
              pos_till_activity_path(inquiry_register_params.merge(session_id: @session_record.id, register_id: @session_record.register_id)),
              class: "btn btn--outline" %>
      </div>
    </main>
  </div>
<% end %>
