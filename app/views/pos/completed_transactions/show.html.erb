<% content_for :title, "Transaction complete" %>

<main class="pos-receipt" data-controller="pos-receipt" data-action="keydown@document->pos-receipt#onKeydown">
  <div class="pos-receipt__screen">
    <header class="pos-header">
      <div class="pos-header__row">
        <span>Store  <%= @transaction.store.admin_label %></span>
        <span>Register  <%= @register.register_number %></span>
        <span><%= current_user.display_name %></span>
      </div>
      <div class="pos-header__date">Business date  <%= @transaction.business_date.iso8601 %></div>
    </header>

    <h1 tabindex="-1" autofocus>Transaction complete</h1>
    <p class="pos-receipt__ref"><%= @transaction.transaction_reference %></p>
    <%= render "pos/receipts/post_void_banner", transaction: @transaction, linked: true %>

    <dl class="pos-receipt__totals">
      <%= render "pos/receipts/directional_totals", transaction: @transaction %>
      <% @tenders.each do |tender| %>
        <div><dt><%= pos_tender_label(tender) %></dt><dd><%= format_money_cents(tender.amount_cents) %></dd></div>
        <% if pos_cash_payment?(tender) %>
          <div><dt>Cash presented</dt><dd><%= format_money_cents(tender.amount_presented_cents) %></dd></div>
          <div><dt>Change</dt><dd><%= format_money_cents(tender.change_cents) %></dd></div>
        <% elsif tender.external_reference.present? %>
          <div><dt>Reference</dt><dd><%= tender.external_reference %></dd></div>
        <% end %>
      <% end %>
    </dl>

    <ul class="pos-receipt__lines">
      <% @transaction.pos_transaction_lines.each do |line| %>
        <li>
          <%= line.quantity %> ×
          <%= pos_line_kind_prefix(line).present? ? "#{pos_line_kind_prefix(line)} #{pos_line_description(line)}" : pos_line_description(line) %>
          <%= format_signed_money_cents(pos_line_amount_cents(line)) %>
        </li>
        <% if line.post_void_generated? && line.post_void_source_line&.pos_transaction %>
          <li class="muted">Post-void of <%= line.post_void_source_line.pos_transaction.transaction_reference %></li>
        <% elsif line.linked_return? && line.original_transaction_line&.pos_transaction %>
          <li class="muted">Return from <%= line.original_transaction_line.pos_transaction.transaction_reference %></li>
        <% elsif line.unlinked_return? %>
          <li class="muted">Unlinked return</li>
          <% if pos_unlinked_return_price_adjusted?(line) %>
            <li class="muted">
              Reference <%= format_money_cents(line.reference_unit_price_cents) %>
              · Return <%= format_money_cents(line.selling_unit_price_cents) %>
            </li>
          <% end %>
        <% end %>
        <% if line.manual_discount_cents.to_i.positive? %>
          <li><%= line.return? ? "Discount reversal" : "Discount" %>  <%= format_signed_money_cents(pos_line_discount_cents(line)) %></li>
        <% end %>
        <% if line.tax_class_overridden? && line.tax_class_name_snapshot.present? %>
          <li class="muted">Applied Tax Class  <%= line.tax_class_name_snapshot %></li>
        <% end %>
        <% line.pos_controlled_actions.each do |action| %>
          <li class="muted"><%= pos_controlled_action_provenance(action) %></li>
        <% end %>
      <% end %>
    </ul>
  </div>

  <%= render "pos/receipts/print", transaction: @transaction, tenders: @tenders, reprint: false %>

  <div class="pos-receipt__actions pos-no-print">
    <% receipt = Pos::CustomerReceipt.build(@transaction) %>
    <% if receipt.printable? %>
      <%= action_button("Print receipt", style: :solid, intent: :brand, data: { action: "pos-receipt#print" }) %>
    <% else %>
      <p class="pos-enter__alert" role="alert"><%= receipt.error %></p>
    <% end %>
    <%= action_link_to("Transactions", pos_transactions_path, style: :outline, intent: :neutral) %>
    <span class="pos-receipt__new">
      <%= action_button_to(
            "New transaction",
            pos_register_continue_path,
            style: :solid,
            intent: :brand,
            method: :post
          ) %>
    </span>
    <%= action_button_to(
          "Close register",
          pos_register_close_path,
          style: :outline,
          intent: :neutral,
          method: :post,
          params: { session_id: @session_record.id }
        ) %>
  </div>
</main>
