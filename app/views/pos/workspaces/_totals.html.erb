<% workspace = @workspace %>

<aside id="pos_totals" class="pos-totals" aria-labelledby="pos-totals-title">
  <h2 id="pos-totals-title" class="pos-totals__title">Summary</h2>
  <% workspace.summary_rows.each do |row| %>
    <div class="<%= "pos-totals__net" if row.key == :net %>">
      <%= row.label %>
      <%= format_signed_money_cents(row.signed_cents) %>
    </div>
  <% end %>
</aside>
