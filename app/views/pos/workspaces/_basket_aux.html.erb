<% gift_card_programs = @gift_card_programs %>
<% show_add = %w[sale_entry tender completion_failed].include?(@ui_mode) && gift_card_programs.any? %>
<% show_customer = @ui_mode == "sale_entry" || @ui_mode == "tender" || @transaction.customer.present? %>

<% if show_add || show_customer %>
  <div class="pos-basket-aux">
    <% if show_add %>
      <%= action_button "Add gift card", style: :solid, intent: :brand, size: :standard,
            data: { action: "register-workspace#openIssuanceOverlay" } %>
    <% end %>

    <% if show_customer %>
      <%= render "pos/workspaces/customer" %>
    <% end %>
  </div>
<% end %>
