<% issuances = @issuances %>

<% if issuances.any? %>
  <section class="pos-issuances" aria-label="Gift cards">
    <% issuances.each do |issuance| %>
      <div class="pos-issuance"
           data-issuance-id="<%= issuance.id %>"
           data-issuance-type="<%= issuance.issuance_type %>"
           data-issuance-amount-cents="<%= issuance.amount_cents %>"
           data-issuance-program-id="<%= issuance.gift_card_program_id %>"
           data-issuance-masked="<%= issuance.masked_card_snapshot.presence || (issuance.pending_card_number_last_four.present? ? "#{issuance.pending_card_number_prefix}••••#{issuance.pending_card_number_last_four}" : "") %>">
        <%= issuance.activation? ? "Activation" : "Reload" %>
        · <%= format_money_cents(issuance.amount_cents) %>
        <% if issuance.masked_card_snapshot.present? || issuance.pending_card_number_last_four.present? %>
          · <%= issuance.masked_card_snapshot.presence || "#{issuance.pending_card_number_prefix}••••#{issuance.pending_card_number_last_four}" %>
        <% elsif issuance.gift_card_program %>
          · <%= issuance.gift_card_program.name %>
        <% end %>
        <% if @workspace.issuance_edit_available || @workspace.issuance_remove_available %>
          <div class="pos-issuance__actions">
            <% if @workspace.issuance_edit_available %>
              <%= action_button "Edit", style: :outline, intent: :neutral, size: :standard,
                    data: { action: "register-workspace#requestEditIssuance", issuance_id: issuance.id } %>
            <% end %>
            <% if @workspace.issuance_remove_available %>
              <%= action_button "Remove", style: :outline, intent: :warning, size: :standard,
                    data: { action: "register-workspace#requestRemoveIssuance", issuance_id: issuance.id } %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>
