  <div class="pos-overlay" data-register-blocking-overlay
       id="pos_issuance_overlay"
       hidden
       data-register-workspace-target="issuanceOverlay"
       role="dialog"
       aria-modal="true"
       aria-labelledby="pos-issuance-title">
    <div class="pos-overlay__panel pos-overlay__panel--control">
      <h2 id="pos-issuance-title" data-register-workspace-target="issuanceTitle">Add gift card</h2>
      <p id="pos-issuance-feedback" class="pos-overlay__error" data-overlay-error role="alert"></p>
      <label for="pos-issuance-amount">Amount</label>
      <input id="pos-issuance-amount" class="pos-command__field" data-register-workspace-target="issuanceAmountField"
             inputmode="decimal" autocomplete="off">
      <label for="pos-issuance-program">Program</label>
      <select id="pos-issuance-program" class="pos-command__field" data-register-workspace-target="issuanceProgramField"
              data-action="change->register-workspace#onIssuanceFieldChange">
        <option value="">Select program</option>
        <% (@gift_card_programs || []).each do |program| %>
          <option value="<%= program.id %>"
                  data-number-authority="<%= program.number_authority %>"
                  data-reload-allowed="<%= program.reload_allowed? %>"><%= program.name %></option>
        <% end %>
      </select>
      <label for="pos-issuance-type">Type</label>
      <select id="pos-issuance-type" class="pos-command__field" data-register-workspace-target="issuanceTypeField"
              data-action="change->register-workspace#onIssuanceFieldChange">
        <option value="activation">Activation</option>
        <option value="reload">Reload</option>
      </select>
      <div data-register-workspace-target="issuanceCardWrap">
        <label for="pos-issuance-card">Scan or enter card</label>
        <input id="pos-issuance-card" class="pos-command__field" data-register-workspace-target="issuanceCardNumber"
               autocomplete="off" inputmode="numeric">
      </div>
      <p class="muted" data-register-workspace-target="issuanceResultLabel"></p>
      <div class="pos-overlay__actions">
        <%= action_button "Keep Transaction Unchanged", style: :outline, intent: :neutral, size: :standard,
              data: { action: "register-workspace#closeIssuanceOverlay", register_workspace_target: "issuanceCancel" } %>
        <%= action_button "Add Gift Card", style: :solid, intent: :brand, size: :standard,
              data: { action: "register-workspace#submitIssuance", register_workspace_target: "issuanceApply" } %>
      </div>
    </div>
  </div>
