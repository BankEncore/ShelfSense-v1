<%
  lines = @lines || @transaction.pos_transaction_lines.includes(:inventory_unit, product_variant: [ :product, :merchandise_condition ])
  tenders = @tenders || @transaction.pos_tenders.ordered.to_a
  tender = @tender || tenders.find { |item| item.cash? && item.direction == "payment" }
  selected_tender_type = @selected_tender_type || tenders && Pos::Support.cash_tender_type
  settlement_direction = @settlement_direction || Pos::Support.settlement_direction(@transaction)
  remaining_payment_cents = @remaining_payment_cents
  remaining_payment_cents = Pos::Support.remaining_payment_cents(@transaction) if remaining_payment_cents.nil?
  remaining_refund_cents = @remaining_refund_cents
  remaining_refund_cents = Pos::Support.remaining_refund_cents(@transaction) if remaining_refund_cents.nil?
  selected_id = @selected_line&.id
  locked = %w[completion_pending completion_failed].include?(@ui_mode)
  leftover = @session_record.reporting_period.business_date != BusinessDate.for_store(current_store)
  refund_mode = settlement_direction == :refund
  even_exchange = @transaction.even_exchange?
  remaining_cents = refund_mode ? remaining_refund_cents : remaining_payment_cents
  change_cents = tender&.change_cents
  completion_recovery = @ui_mode == "completion_failed"
  register_scope = { register_id: @register.id }
  cash_selected = selected_tender_type&.cash?
  show_reference = @ui_mode == "tender" && selected_tender_type&.reference_captured?
  command_value = @command_value
  if command_value.blank? && @ui_mode == "tender" && refund_mode
    command_value = money_field_value(remaining_refund_cents)
  end
  command_inputmode =
    if @ui_mode == "quantity"
      "numeric"
    elsif @ui_mode == "tender"
      "decimal"
    else
      "text"
    end
  remaining_label = refund_mode ? "Refund due #{format_money_cents(remaining_cents)}" : "Amount due #{format_money_cents(remaining_cents)}"
  command_label =
    if @ui_mode == "quantity" && @selected_line
      "#{pos_line_description(@selected_line)} · Current quantity #{@selected_line.quantity}"
    elsif @ui_mode == "tender"
      if refund_mode
        cash_selected ? "#{remaining_label}. Refund amount" : "#{remaining_label}. #{selected_tender_type&.name} amount"
      elsif cash_selected
        "#{remaining_label}. Cash presented"
      else
        "Remaining #{format_money_cents(remaining_cents)}. #{selected_tender_type&.name} amount"
      end
    elsif locked
      refund_mode ? "Refund (locked)" : "Tender (locked)"
    else
      "Scan or identifier"
    end
  tender_mode_label = if refund_mode
    "REFUND"
  else
    cash_selected || locked ? "CASH TENDER" : "TENDER"
  end
  sale_lines = lines.select(&:sale?)
  return_lines = lines.select(&:return?)
%>

<div id="pos_workspace"
     class="pos-shell"
     data-controller="register-workspace"
     data-register-workspace-mode-value="<%= @ui_mode %>"
     data-register-workspace-auto-complete-value="<%= @auto_complete ? "true" : "false" %>"
     data-register-workspace-workspace-url-value="<%= pos_register_workspace_path(register_scope) %>"
     data-register-workspace-tender-types-value="<%= h((@cashier_tender_types || []).map(&:cashier_payload).to_json) %>"
     data-register-workspace-settlement-value="<%= settlement_direction %>"
     data-register-workspace-refund-remaining-value="<%= remaining_refund_cents %>"
     data-register-workspace-payment-remaining-value="<%= remaining_payment_cents %>"
     data-register-workspace-transactions-url-value="<%= pos_transactions_path %>"
     data-register-workspace-policies-value="<%= h((@control_policies || {}).to_json) %>"
     data-register-workspace-reasons-value="<%= h(Pos::ControlledActionReasons::CATALOGS.to_json) %>"
     data-register-workspace-return-reasons-value="<%= h(Pos::ReturnReasons::ENTRIES.to_json) %>"
     data-register-workspace-unlinked-lookup-url-value="<%= pos_register_unlinked_return_lookup_path(register_scope) %>"
     data-register-workspace-linked-lookup-url-value="<%= pos_register_linked_return_lookup_path(register_scope) %>"
     data-register-workspace-resolve-url-value="<%= pos_register_merchandise_resolve_path(register_scope) %>"
     data-register-workspace-search-url-value="<%= pos_register_merchandise_search_path(register_scope) %>"
     data-register-workspace-open-price-url-value="<%= pos_register_open_price_path(register_scope) %>"
     data-action="turbo:submit-end->register-workspace#onSubmitEnd">
  <div data-register-workspace-target="chrome">
    <header class="pos-header">
      <div class="pos-header__row">
        <span>Store  <%= current_store.admin_label %></span>
        <span>Register  <%= @register.register_number %></span>
        <span><%= current_user.display_name %></span>
        <nav class="pos-header__nav" aria-label="Register">
          <%= link_to "POS Home", pos_path, class: "pos-header__link" %>
          <%= link_to "Transactions", pos_transactions_path, class: "pos-header__link" %>
          <%= link_to "X Report", pos_x_report_path, class: "pos-header__link" %>
          <% if @ui_mode == "sale_entry" && lines.empty? && tenders.empty? %>
            <%= button_to "Close register", pos_register_close_path, method: :post,
                  params: { session_id: @session_record.id, register_id: @register.id }, class: "btn btn--secondary" %>
          <% end %>
        </nav>
      </div>
      <div class="pos-header__date <%= "pos-date-emphasis" if leftover %>">
        Business date  <%= @session_record.reporting_period.business_date.iso8601 %>
      </div>
      <% if leftover %>
        <p class="pos-banner" role="status">This register is still on business date <%= @session_record.reporting_period.business_date.iso8601 %>.</p>
      <% end %>
    </header>

    <div class="pos-main">
      <div id="pos_basket" class="pos-basket">
        <table class="pos-lines">
          <thead>
            <tr>
              <th>Qty</th>
              <th>Description</th>
              <th class="numeric">Unit</th>
              <th class="numeric">Ext</th>
            </tr>
          </thead>
          <tbody>
            <% lines.each do |line| %>
              <% original = line.original_transaction_line&.pos_transaction %>
              <tr class="<%= [ ("is-selected" if line.id == selected_id), ("is-controlled" if pos_line_controlled?(line)) ].compact.join(" ") %>"
                  data-line-id="<%= line.id %>"
                  data-quantity="<%= line.quantity %>"
                  data-description="<%= pos_line_description(line) %>"
                  data-direction="<%= line.direction %>"
                  data-linked-return="<%= line.linked_return? %>"
                  data-unit-line="<%= line.unit_line? %>"
                  data-price-overridden="<%= line.price_overridden? %>"
                  data-discounted="<%= line.manually_discounted? %>"
                  data-tax-overridden="<%= line.tax_class_overridden? %>"
                  data-selling-cents="<%= line.selling_unit_price_cents %>"
                  data-discount-bp="<%= line.manual_discount_basis_points %>"
                  data-tax-class-id="<%= line.tax_class_id %>"
                  data-pricing-method-snapshot="<%= line.pricing_method_snapshot %>"
                  aria-selected="<%= line.id == selected_id %>">
                <td><%= line.id == selected_id ? ">" : "" %> <%= line.quantity %></td>
                <td>
                  <%= line.return? ? "RETURN · #{pos_line_description(line)}" : pos_line_description(line) %>
                  <% if pos_line_controlled?(line) %>
                    <span class="pos-line-flags"><%= pos_line_control_flags(line) %></span>
                  <% end %>
                  <% if line.linked_return? %>
                    <div class="muted">
                      <% if original %>From <%= original.transaction_reference %><% end %>
                      <% if line.return_reason_name_snapshot.present? %>
                        <%= original ? " · " : "" %><%= line.return_reason_name_snapshot %>
                      <% end %>
                    </div>
                  <% elsif line.unlinked_return? %>
                    <div class="muted">
                      Unlinked return
                      <% if line.return_reason_name_snapshot.present? %>
                        · <%= line.return_reason_name_snapshot %>
                      <% end %>
                    </div>
                    <% if pos_unlinked_return_price_adjusted?(line) %>
                      <div class="muted">
                        Reference <%= format_money_cents(line.reference_unit_price_cents) %>
                        · Return <%= format_money_cents(line.selling_unit_price_cents) %>
                      </div>
                    <% end %>
                  <% end %>
                </td>
                <td class="numeric"><%= format_money_cents(line.selling_unit_price_cents) %></td>
                <td class="numeric"><%= format_signed_money_cents(pos_line_amount_cents(line)) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <aside id="pos_totals" class="pos-totals">
        <% if sale_lines.any? %>
          <div>Sales  <%= format_money_cents(@transaction.sale_total_cents) %></div>
          <% if @transaction.discount_cents.positive? %>
            <div>Discount  <%= format_money_cents(@transaction.discount_cents) %></div>
          <% end %>
        <% end %>
        <% if return_lines.any? %>
          <div>Returns  <%= format_signed_money_cents(-@transaction.return_total_cents) %></div>
          <% if @transaction.return_discount_cents.positive? %>
            <div>Discount reversal  <%= format_signed_money_cents(@transaction.return_discount_cents) %></div>
          <% end %>
        <% end %>
        <div>Net  <%= format_signed_money_cents(@transaction.signed_net_cents) %></div>
        <% tenders.each do |working_tender| %>
          <div><%= pos_tender_label(working_tender) %>  <%= format_money_cents(working_tender.amount_cents) %></div>
        <% end %>
        <% if Pos::Support.exact_settlement?(@transaction) && tender %>
          <div>Cash presented  <%= format_money_cents(tender.amount_presented_cents) %></div>
          <div class="pos-totals__change">CHANGE  <%= format_money_cents(change_cents) %></div>
        <% elsif even_exchange && @ui_mode == "sale_entry" %>
          <div>Even exchange</div>
        <% elsif settlement_direction == :refund %>
          <div class="pos-totals__due">Refund due  <%= format_money_cents(remaining_cents) %></div>
        <% elsif settlement_direction == :payment %>
          <div class="pos-totals__due">Amount due  <%= format_money_cents(remaining_cents) %></div>
        <% end %>
      </aside>
    </div>

    <div id="pos_feedback" class="pos-feedback" data-register-workspace-target="feedback" role="<%= @feedback.present? ? "alert" : "status" %>" aria-live="<%= @feedback.present? ? "assertive" : "polite" %>">
      <% if @ui_mode == "completion_pending" && @feedback.blank? %>
        Completing transaction…
      <% elsif @feedback.present? %>
        <%= @feedback %>
        <% if @ui_mode == "completion_failed" %>
          Tender is kept. Retry does not take it again.
        <% end %>
      <% end %>
    </div>

    <div id="pos_command" class="pos-command">
      <div class="pos-command__mode" data-register-workspace-target="modeLabel"><%= @ui_mode == "sale_entry" || @ui_mode == "quantity" ? pos_mode_label(@ui_mode) : tender_mode_label %></div>
      <label for="pos-command-field" data-register-workspace-target="fieldLabel"><%= command_label %></label>
      <input id="pos-command-field"
             class="pos-command__field"
             data-register-workspace-target="field"
             value="<%= command_value %>"
             inputmode="<%= command_inputmode %>"
             autocomplete="off"
             <%= "disabled" if locked || @ui_mode == "completion_pending" %>
             <%= "autofocus" unless locked || @ui_mode == "completion_failed" || completion_recovery %>>
      <div data-register-workspace-target="referenceWrap" <%= "hidden" unless show_reference %>>
        <label for="pos-reference-field" data-register-workspace-target="referenceLabel">
          <%= selected_tender_type&.reference_field_label || "Reference" %>
        </label>
        <input id="pos-reference-field"
               class="pos-command__field"
               data-register-workspace-target="referenceField"
               autocomplete="off">
      </div>
    </div>

    <div id="pos_actions" class="pos-actions">
      <% if completion_recovery %>
        <button type="button" class="btn" data-action="register-workspace#submitComplete" data-register-workspace-target="retry" autofocus>Retry complete</button>
        <%= button_to "Return to sale", pos_register_abandon_tender_path, method: :post,
              params: { lock_version: @transaction.lock_version, register_id: @register.id },
              class: "btn btn--secondary",
              form: { data: { turbo: true } },
              data: { register_workspace_target: "abandonButton" } %>
      <% else %>
        <button type="button" class="btn btn--secondary" data-action="register-workspace#openReturnChooser" data-register-workspace-target="returnButton">Return (-)</button>
        <button type="button" class="btn btn--secondary" data-action="register-workspace#enterQuantity" data-register-workspace-target="quantityButton" disabled>Quantity (*)</button>
        <button type="button" class="btn btn--secondary" data-action="register-workspace#openPriceOverride" data-register-workspace-target="overrideButton" disabled>Price (F6)</button>
        <button type="button" class="btn btn--secondary" data-action="register-workspace#openLineDiscount" data-register-workspace-target="discountButton" disabled>Discount (F7)</button>
        <button type="button" class="btn btn--secondary" data-action="register-workspace#openTaxClassOverride" data-register-workspace-target="taxClassButton" disabled>Tax Class</button>
        <button type="button" class="btn btn--secondary" data-action="register-workspace#chooseCash" data-register-workspace-target="cashButton" disabled>Cash (F1)</button>
        <button type="button" class="btn btn--secondary" data-action="register-workspace#chooseCard" data-register-workspace-target="cardButton" disabled>Card (F2)</button>
        <button type="button" class="btn btn--secondary" data-action="register-workspace#chooseCheck" data-register-workspace-target="checkButton" disabled>Check (F3)</button>
        <button type="button" class="btn btn--secondary" data-action="register-workspace#chooseOther" data-register-workspace-target="otherButton" disabled>Other (F4)</button>
        <button type="button" class="btn btn--secondary" data-action="register-workspace#enterTender" data-register-workspace-target="tenderButton" disabled><%= even_exchange ? "Complete (+)" : (refund_mode ? "Refund (+)" : "Tender (+)") %></button>
        <button type="button" class="btn btn--secondary" data-action="register-workspace#removeSelected" data-register-workspace-target="removeButton" disabled>Remove (F8)</button>
        <% if @ui_mode == "tender" && tenders.any? %>
          <%= button_to "Return to sale", pos_register_abandon_tender_path, method: :post,
                params: { lock_version: @transaction.lock_version, register_id: @register.id },
                class: "btn btn--secondary",
                form: { data: { turbo: true } },
                data: { register_workspace_target: "abandonButton" } %>
        <% end %>
      <% end %>
      <div data-register-workspace-target="clientRecovery" hidden>
        <button type="button" class="btn" data-action="register-workspace#submitComplete">Retry complete</button>
      </div>
      <button type="button"
              class="btn btn--danger"
              data-action="register-workspace#openOverlay"
              data-register-workspace-target="cancelButton"
              disabled>
        Cancel (F9)
      </button>
    </div>

    <%= form_with url: pos_register_merchandise_path(register_scope), method: :post, html: { class: "pos-hidden", data: { register_workspace_target: "merchandiseForm", turbo: true } } do %>
      <%= hidden_field_tag :register_id, @register.id %>
      <%= hidden_field_tag :lock_version, @transaction.lock_version %>
      <%= hidden_field_tag :selected_line_id, selected_id %>
      <%= hidden_field_tag :identifier, "", data: { register_workspace_target: "identifierInput" } %>
      <%= hidden_field_tag :product_variant_id, "", data: { register_workspace_target: "variantInput" } %>
      <%= hidden_field_tag :inventory_unit_id, "", data: { register_workspace_target: "unitInput" } %>
      <%= hidden_field_tag :selling_price, "", data: { register_workspace_target: "openPriceInput" } %>
    <% end %>

    <%= form_with url: pos_register_quantity_path(register_scope), method: :post, html: { class: "pos-hidden", data: { register_workspace_target: "quantityForm", turbo: true } } do %>
      <%= hidden_field_tag :register_id, @register.id %>
      <%= hidden_field_tag :lock_version, @transaction.lock_version %>
      <%= hidden_field_tag :line_id, selected_id, data: { register_workspace_target: "quantityLineInput" } %>
      <%= hidden_field_tag :quantity, "", data: { register_workspace_target: "quantityInput" } %>
    <% end %>

    <%= form_with url: pos_register_remove_path(register_scope), method: :post, html: { class: "pos-hidden", data: { register_workspace_target: "removeForm", turbo: true } } do %>
      <%= hidden_field_tag :register_id, @register.id %>
      <%= hidden_field_tag :lock_version, @transaction.lock_version %>
      <%= hidden_field_tag :line_id, selected_id, data: { register_workspace_target: "removeLineInput" } %>
    <% end %>

    <%= form_with url: pos_register_tender_path(register_scope), method: :post, html: { class: "pos-hidden", data: { register_workspace_target: "tenderForm", turbo: true } } do %>
      <%= hidden_field_tag :register_id, @register.id %>
      <%= hidden_field_tag :lock_version, @transaction.lock_version %>
      <%= hidden_field_tag :tender_amount, "", data: { register_workspace_target: "presentedInput" } %>
      <%= hidden_field_tag :tender_type_id, selected_tender_type&.id, data: { register_workspace_target: "tenderTypeInput" } %>
      <%= hidden_field_tag :external_reference, "", data: { register_workspace_target: "referenceInput" } %>
    <% end %>

    <%= form_with url: pos_register_remove_tender_path(register_scope), method: :post, html: { class: "pos-hidden", data: { register_workspace_target: "removeTenderForm", turbo: true } } do %>
      <%= hidden_field_tag :register_id, @register.id %>
      <%= hidden_field_tag :lock_version, @transaction.lock_version %>
      <%= hidden_field_tag :tender_id, tenders.last&.id, data: { register_workspace_target: "removeTenderInput" } %>
    <% end %>

    <%= form_with url: pos_transaction_complete_path(@transaction), method: :post, html: { class: "pos-hidden", data: { register_workspace_target: "completeForm", turbo: true } } do %>
      <%= hidden_field_tag :lock_version, @transaction.lock_version %>
      <%= hidden_field_tag :completion_operation_id, @completion_operation_id %>
      <%= hidden_field_tag :expected_total_cents, @transaction.total_cents %>
      <%= hidden_field_tag :expected_signed_net_cents, @transaction.signed_net_cents %>
    <% end %>

    <%= form_with url: pos_register_controlled_action_path(register_scope), method: :post, html: { class: "pos-hidden", data: { register_workspace_target: "controlForm", turbo: true } } do %>
      <%= hidden_field_tag :register_id, @register.id %>
      <%= hidden_field_tag :lock_version, @transaction.lock_version %>
      <%= hidden_field_tag :line_id, selected_id, data: { register_workspace_target: "controlLineInput" } %>
      <%= hidden_field_tag :action_type, "", data: { register_workspace_target: "controlActionInput" } %>
      <%= hidden_field_tag :operation, "apply", data: { register_workspace_target: "controlOperationInput" } %>
      <%= hidden_field_tag :reason_code, "", data: { register_workspace_target: "controlReasonInput" } %>
      <%= hidden_field_tag :reason_note, "", data: { register_workspace_target: "controlNoteInput" } %>
      <%= hidden_field_tag :selling_price, "", data: { register_workspace_target: "controlPriceInput" } %>
      <%= hidden_field_tag :discount_percent, "", data: { register_workspace_target: "controlDiscountInput" } %>
      <%= hidden_field_tag :tax_class_id, "", data: { register_workspace_target: "controlTaxInput" } %>
      <%= hidden_field_tag :approver_username, "", data: { register_workspace_target: "controlApproverUserInput" } %>
      <%= hidden_field_tag :approver_password, "", data: { register_workspace_target: "controlApproverPasswordInput" } %>
    <% end %>

    <%= form_with url: pos_register_unlinked_return_path(register_scope), method: :post, html: { class: "pos-hidden", data: { register_workspace_target: "unlinkedForm", turbo: true } } do %>
      <%= hidden_field_tag :register_id, @register.id %>
      <%= hidden_field_tag :lock_version, @transaction.lock_version %>
      <%= hidden_field_tag :identifier, "", data: { register_workspace_target: "unlinkedIdentifierInput" } %>
      <%= hidden_field_tag :quantity, "", data: { register_workspace_target: "unlinkedQuantityInput" } %>
      <%= hidden_field_tag :reason_code, "", data: { register_workspace_target: "unlinkedReasonInput" } %>
      <%= hidden_field_tag :reason_note, "", data: { register_workspace_target: "unlinkedNoteInput" } %>
      <%= hidden_field_tag :return_price, "", data: { register_workspace_target: "unlinkedPriceInput" } %>
      <%= hidden_field_tag :expected_product_variant_id, "", data: { register_workspace_target: "unlinkedExpectedVariantInput" } %>
      <%= hidden_field_tag :expected_inventory_unit_id, "", data: { register_workspace_target: "unlinkedExpectedUnitInput" } %>
      <%= hidden_field_tag :expected_reference_unit_price_cents, "", data: { register_workspace_target: "unlinkedExpectedReferenceInput" } %>
      <%= hidden_field_tag :expected_tax_class_id, "", data: { register_workspace_target: "unlinkedExpectedTaxInput" } %>
      <%= hidden_field_tag :approver_username, "", data: { register_workspace_target: "unlinkedApproverUserInput" } %>
      <%= hidden_field_tag :approver_password, "", data: { register_workspace_target: "unlinkedApproverPasswordInput" } %>
    <% end %>

    <%= form_with url: pos_register_open_price_path(register_scope), method: :post, html: { class: "pos-hidden", data: { register_workspace_target: "openPriceForm", turbo: true } } do %>
      <%= hidden_field_tag :register_id, @register.id %>
      <%= hidden_field_tag :lock_version, @transaction.lock_version %>
      <%= hidden_field_tag :line_id, selected_id, data: { register_workspace_target: "openPriceLineInput" } %>
      <%= hidden_field_tag :selling_price, "", data: { register_workspace_target: "openPriceEditInput" } %>
    <% end %>

    <%= form_with url: pos_register_linked_return_path(register_scope), method: :post, html: { class: "pos-hidden", data: { register_workspace_target: "linkedReturnForm", turbo: true } } do %>
      <%= hidden_field_tag :register_id, @register.id %>
      <%= hidden_field_tag :lock_version, @transaction.lock_version %>
      <%= hidden_field_tag :original_line_id, "", data: { register_workspace_target: "linkedOriginalInput" } %>
      <%= hidden_field_tag :quantity, "1", data: { register_workspace_target: "linkedQuantityInput" } %>
      <%= hidden_field_tag :reason_code, "", data: { register_workspace_target: "linkedReasonInput" } %>
      <%= hidden_field_tag :reason_note, "", data: { register_workspace_target: "linkedNoteInput" } %>
    <% end %>

    <%= form_with url: pos_register_cancel_path(register_scope), method: :post, html: { class: "pos-hidden", data: { register_workspace_target: "cancelForm", turbo: true } } do %>
      <%= hidden_field_tag :register_id, @register.id %>
      <%= hidden_field_tag :lock_version, @transaction.lock_version %>
    <% end %>
  </div>

  <div class="pos-overlay"
       id="pos_overlay"
       hidden
       data-register-workspace-target="overlay"
       role="dialog"
       aria-modal="true"
       aria-labelledby="pos-cancel-title">
    <div class="pos-overlay__panel">
      <h2 id="pos-cancel-title">Cancel this transaction?</h2>
      <p>Lines will not be sold or returned. No receipt. No inventory movement.</p>
      <button type="button" class="btn btn--secondary" data-action="register-workspace#closeOverlay" data-register-workspace-target="dontCancel">Don't cancel (Esc)</button>
      <button type="button" class="btn btn--danger" data-action="register-workspace#confirmCancel" data-register-workspace-target="confirmCancel">Cancel transaction (F9)</button>
    </div>
  </div>

  <div class="pos-overlay"
       id="pos_control_overlay"
       hidden
       data-register-workspace-target="controlOverlay"
       role="dialog"
       aria-modal="true"
       aria-labelledby="pos-control-title">
    <div class="pos-overlay__panel pos-overlay__panel--control">
      <h2 id="pos-control-title" data-register-workspace-target="controlTitle">Controlled action</h2>
      <p data-register-workspace-target="controlLineLabel"></p>
      <p id="pos-control-feedback" class="pos-overlay__error" data-overlay-error role="alert"></p>

      <div data-register-workspace-target="controlPriceWrap">
        <label for="pos-control-price">Selling price</label>
        <input id="pos-control-price" class="pos-command__field" data-register-workspace-target="controlPriceField" inputmode="decimal" autocomplete="off">
      </div>

      <div data-register-workspace-target="controlDiscountWrap" hidden>
        <label for="pos-control-discount">Discount percent</label>
        <input id="pos-control-discount" class="pos-command__field" data-register-workspace-target="controlDiscountField" inputmode="decimal" autocomplete="off">
      </div>

      <div data-register-workspace-target="controlTaxWrap" hidden>
        <label for="pos-control-tax-class">Tax Class</label>
        <select id="pos-control-tax-class" class="pos-command__field" data-register-workspace-target="controlTaxField">
          <% (@tax_classes || TaxClass.none).each do |tax_class| %>
            <option value="<%= tax_class.id %>"><%= tax_class.admin_label %></option>
          <% end %>
        </select>
      </div>

      <label for="pos-control-reason">Reason</label>
      <select id="pos-control-reason" class="pos-command__field" data-register-workspace-target="controlReasonField"></select>

      <div data-register-workspace-target="controlNoteWrap" hidden>
        <label for="pos-control-note">Note</label>
        <input id="pos-control-note" class="pos-command__field" data-register-workspace-target="controlNoteField" maxlength="200" autocomplete="off">
      </div>

      <div data-register-workspace-target="controlApproverWrap" hidden>
        <label for="pos-approver-username">Approver username</label>
        <input id="pos-approver-username" class="pos-command__field" data-register-workspace-target="approverUsername" autocomplete="off">
        <label for="pos-approver-password">Approver password</label>
        <input id="pos-approver-password" class="pos-command__field" type="password" data-register-workspace-target="approverPassword" autocomplete="off">
      </div>

      <div class="pos-overlay__actions">
        <button type="button" class="btn btn--secondary" data-action="register-workspace#closeControlOverlay" data-register-workspace-target="controlCancel">Don't apply (Esc)</button>
        <button type="button" class="btn" data-action="register-workspace#submitControlApply" data-register-workspace-target="controlApply">Apply</button>
        <button type="button" class="btn btn--secondary" data-action="register-workspace#submitControlRemove" data-register-workspace-target="controlRemove" hidden>Remove</button>
      </div>
    </div>
  </div>

  <div class="pos-overlay"
       id="pos_unlinked_overlay"
       hidden
       data-register-workspace-target="unlinkedOverlay"
       role="dialog"
       aria-modal="true"
       aria-labelledby="pos-unlinked-title">
    <div class="pos-overlay__panel pos-overlay__panel--control">
      <h2 id="pos-unlinked-title">Return without receipt</h2>
      <p id="pos-unlinked-feedback" class="pos-overlay__error" data-register-workspace-target="unlinkedFeedback" data-overlay-error role="alert"></p>

      <label for="pos-unlinked-identifier">Scan or identifier</label>
      <input id="pos-unlinked-identifier" class="pos-command__field" data-register-workspace-target="unlinkedIdentifierField" autocomplete="off">

      <div id="pos_unlinked_preview" data-register-workspace-target="unlinkedPreview" hidden>
        <p data-register-workspace-target="unlinkedDescription"></p>
        <p>Current price <span data-register-workspace-target="unlinkedReferenceLabel"></span></p>

        <div data-register-workspace-target="unlinkedQuantityWrap">
          <label for="pos-unlinked-quantity">Quantity</label>
          <input id="pos-unlinked-quantity" class="pos-command__field" data-register-workspace-target="unlinkedQuantityField" inputmode="numeric" autocomplete="off" value="1">
        </div>

        <label for="pos-unlinked-reason">Return reason</label>
        <select id="pos-unlinked-reason" class="pos-command__field" data-register-workspace-target="unlinkedReasonField"></select>

        <div data-register-workspace-target="unlinkedNoteWrap" hidden>
          <label for="pos-unlinked-note">Note</label>
          <input id="pos-unlinked-note" class="pos-command__field" data-register-workspace-target="unlinkedNoteField" maxlength="200" autocomplete="off">
        </div>

        <label for="pos-unlinked-price">Return unit price</label>
        <input id="pos-unlinked-price" class="pos-command__field" data-register-workspace-target="unlinkedPriceField" inputmode="decimal" autocomplete="off">

        <div data-register-workspace-target="unlinkedApproverWrap" hidden>
          <label for="pos-unlinked-approver-username">Approver username</label>
          <input id="pos-unlinked-approver-username" class="pos-command__field" data-register-workspace-target="unlinkedApproverUsername" autocomplete="off">
          <label for="pos-unlinked-approver-password">Approver password</label>
          <input id="pos-unlinked-approver-password" class="pos-command__field" type="password" data-register-workspace-target="unlinkedApproverPassword" autocomplete="off">
        </div>
      </div>

      <div class="pos-overlay__actions">
        <button type="button" class="btn btn--secondary" data-action="register-workspace#closeUnlinkedOverlay" data-register-workspace-target="unlinkedCancel">Don't return (Esc)</button>
        <button type="button" class="btn" data-action="register-workspace#submitUnlinkedReturn" data-register-workspace-target="unlinkedApply" hidden>Add return</button>
      </div>
    </div>
  </div>

  <div class="pos-overlay"
       id="pos_other_overlay"
       hidden
       data-register-workspace-target="otherOverlay"
       role="dialog"
       aria-modal="true"
       aria-labelledby="pos-other-title">
    <div class="pos-overlay__panel">
      <h2 id="pos-other-title">Other tender</h2>
      <ul class="pos-picker" role="listbox" aria-labelledby="pos-other-title" data-register-workspace-target="otherList"></ul>
      <p class="muted">Enter selects the highlighted tender. Esc cancels.</p>
      <button type="button" class="btn btn--secondary" data-action="register-workspace#closeOtherOverlay">Cancel (Esc)</button>
    </div>
  </div>

  <div class="pos-overlay"
       id="pos_search_overlay"
       hidden
       data-register-workspace-target="searchOverlay"
       role="dialog"
       aria-modal="true"
       aria-labelledby="pos-search-title">
    <div class="pos-overlay__panel">
      <h2 id="pos-search-title">Search merchandise</h2>
      <label class="field">
        <span>SKU</span>
        <input type="text" autocomplete="off" data-register-workspace-target="searchSkuField">
      </label>
      <label class="field">
        <span>Product name</span>
        <input type="text" autocomplete="off" data-register-workspace-target="searchNameField">
      </label>
      <p class="muted" data-register-workspace-target="searchQueryLabel"></p>
      <ul class="pos-picker" role="listbox" aria-labelledby="pos-search-title" data-register-workspace-target="searchList"></ul>
      <p class="muted">Enter searches, then Enter selects the highlighted item. Esc cancels.</p>
      <button type="button" class="btn btn--secondary" data-action="register-workspace#closeSearchOverlay">Cancel (Esc)</button>
    </div>
  </div>

  <div class="pos-overlay"
       id="pos_variant_overlay"
       hidden
       data-register-workspace-target="variantOverlay"
       role="dialog"
       aria-modal="true"
       aria-labelledby="pos-variant-title">
    <div class="pos-overlay__panel">
      <h2 id="pos-variant-title">Choose variant</h2>
      <ul class="pos-picker" role="listbox" aria-labelledby="pos-variant-title" data-register-workspace-target="variantList"></ul>
      <p class="muted">Enter selects the highlighted variant. Esc cancels.</p>
      <button type="button" class="btn btn--secondary" data-action="register-workspace#closeVariantOverlay">Cancel (Esc)</button>
    </div>
  </div>

  <div class="pos-overlay"
       id="pos_unit_overlay"
       hidden
       data-register-workspace-target="unitOverlay"
       role="dialog"
       aria-modal="true"
       aria-labelledby="pos-unit-title">
    <div class="pos-overlay__panel">
      <h2 id="pos-unit-title">Choose unit</h2>
      <ul class="pos-picker" role="listbox" aria-labelledby="pos-unit-title" data-register-workspace-target="unitList"></ul>
      <p class="muted">Enter selects the highlighted unit. Esc cancels.</p>
      <button type="button" class="btn btn--secondary" data-action="register-workspace#closeUnitOverlay">Cancel (Esc)</button>
    </div>
  </div>

  <div class="pos-overlay"
       id="pos_open_price_overlay"
       hidden
       data-register-workspace-target="openPriceOverlay"
       role="dialog"
       aria-modal="true"
       aria-labelledby="pos-open-price-title">
    <div class="pos-overlay__panel">
      <h2 id="pos-open-price-title">Open price</h2>
      <p data-register-workspace-target="openPricePrompt"></p>
      <p id="pos-open-price-feedback" class="pos-overlay__error" data-overlay-error role="alert"></p>
      <label class="field">
        <span>Price</span>
        <input type="text" inputmode="decimal" autocomplete="off" data-register-workspace-target="openPriceField">
      </label>
      <div class="pos-overlay__actions">
        <button type="button" class="btn btn--secondary" data-action="register-workspace#closeOpenPriceOverlay">Cancel (Esc)</button>
        <button type="button" class="btn" data-action="register-workspace#submitOpenPricePrompt">Apply</button>
      </div>
    </div>
  </div>

  <div class="pos-overlay"
       id="pos_return_chooser"
       hidden
       data-register-workspace-target="returnChooserOverlay"
       role="dialog"
       aria-modal="true"
       aria-labelledby="pos-return-chooser-title">
    <div class="pos-overlay__panel">
      <h2 id="pos-return-chooser-title">RETURN</h2>
      <ul class="pos-picker" role="listbox" aria-labelledby="pos-return-chooser-title" data-register-workspace-target="returnChooserList">
        <li data-choice="linked" class="is-selected" role="option" tabindex="0" aria-selected="true">Linked return</li>
        <li data-choice="unlinked" role="option" tabindex="-1" aria-selected="false">Unlinked return</li>
      </ul>
      <p class="muted">Enter chooses. Esc cancels.</p>
      <button type="button" class="btn btn--secondary" data-action="register-workspace#closeReturnChooser">Cancel (Esc)</button>
    </div>
  </div>

  <div class="pos-overlay"
       id="pos_linked_overlay"
       hidden
       data-register-workspace-target="linkedOverlay"
       role="dialog"
       aria-modal="true"
       aria-labelledby="pos-linked-title">
    <div class="pos-overlay__panel">
      <h2 id="pos-linked-title">Linked return</h2>
      <label class="field">
        <span>Receipt, merchandise, or unit</span>
        <input type="text" autocomplete="off" data-register-workspace-target="linkedLookupField">
      </label>
      <p id="pos-linked-feedback" class="pos-overlay__error" data-register-workspace-target="linkedFeedback" data-overlay-error role="alert"></p>
      <ul class="pos-picker" role="listbox" aria-labelledby="pos-linked-title" data-register-workspace-target="linkedList"></ul>
      <label class="field">
        <span>Qty</span>
        <input type="text" inputmode="numeric" autocomplete="off" value="1" data-register-workspace-target="linkedQuantityField">
      </label>
      <label class="field">
        <span>Reason</span>
        <select data-register-workspace-target="linkedReasonField"></select>
      </label>
      <label class="field" hidden data-register-workspace-target="linkedNoteWrap">
        <span>Note</span>
        <input type="text" maxlength="200" autocomplete="off" data-register-workspace-target="linkedNoteField">
      </label>
      <p class="muted">Enter in the lookup field searches. Enter on a highlighted line adds it. Esc cancels.</p>
      <button type="button" class="btn btn--secondary" data-action="register-workspace#closeLinkedOverlay">Cancel (Esc)</button>
    </div>
  </div>
</div>
