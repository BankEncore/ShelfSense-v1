<%
  lines = @lines || @transaction.pos_transaction_lines.includes(:inventory_unit, product_variant: [ :product, :merchandise_condition ])
  tenders = @tenders || @transaction.pos_tenders.ordered.to_a
  tender = @tender || tenders.find { |item| item.cash? && item.direction == "payment" }
  selected_tender_type = @selected_tender_type || tenders && Pos::Support.cash_tender_type
  settlement_direction = @settlement_direction || Pos::Support.settlement_direction(@transaction)
  remaining_payment_cents = @remaining_payment_cents
  remaining_payment_cents = Pos::Support.remaining_payment_cents(@transaction) if remaining_payment_cents.nil?
  remaining_refund_cents = @remaining_refund_cents
  remaining_refund_cents = Pos::Support.remaining_refund_cents(@transaction) if remaining_refund_cents.nil?
  selected_id = @selected_line&.id
  locked = %w[completion_pending completion_failed].include?(@ui_mode)
  refund_mode = settlement_direction == :refund
  even_exchange = @transaction.even_exchange?
  remaining_cents = refund_mode ? remaining_refund_cents : remaining_payment_cents
  change_cents = tender&.change_cents
  completion_recovery = @ui_mode == "completion_failed"
  register_scope = { register_id: @register.id }
  cash_selected = selected_tender_type&.cash?
  show_reference = @ui_mode == "tender" && selected_tender_type&.reference_captured?
  command_value = @command_value
  if command_value.blank? && @ui_mode == "tender" && refund_mode
    command_value = money_field_value(remaining_refund_cents)
  end
  command_inputmode =
    if @ui_mode == "quantity"
      "numeric"
    elsif @ui_mode == "tender"
      "decimal"
    else
      "text"
    end
  remaining_label = refund_mode ? "Refund due #{format_money_cents(remaining_cents)}" : "Amount due #{format_money_cents(remaining_cents)}"
  command_label =
    if @ui_mode == "quantity" && @selected_line
      "#{pos_line_description(@selected_line)} · Current quantity #{@selected_line.quantity}"
    elsif @ui_mode == "tender"
      if refund_mode
        cash_selected ? "#{remaining_label}. Refund amount" : "#{remaining_label}. #{selected_tender_type&.name} amount"
      elsif cash_selected
        "#{remaining_label}. Cash presented"
      else
        "Remaining #{format_money_cents(remaining_cents)}. #{selected_tender_type&.name} amount"
      end
    elsif locked
      refund_mode ? "Refund (locked)" : "Tender (locked)"
    else
      "Scan or identifier"
    end
  tender_mode_label = if refund_mode
    "REFUND"
  else
    cash_selected || locked ? "CASH TENDER" : "TENDER"
  end
  sale_lines = lines.select(&:sale?)
  return_lines = lines.select(&:return?)
  issuances = @issuances || @transaction.pos_stored_value_issuances.ordered.to_a
  gift_card_programs = @gift_card_programs || GiftCardProgram.active.admin_ordered.to_a
%>

<div id="pos_workspace"
     class="pos-shell"
     data-controller="register-workspace"
     data-register-workspace-mode-value="<%= @ui_mode %>"
     data-register-workspace-auto-complete-value="<%= @auto_complete ? "true" : "false" %>"
     data-register-workspace-workspace-url-value="<%= pos_register_workspace_path(register_scope) %>"
     data-register-workspace-tender-types-value="<%= h((@cashier_tender_types || []).map(&:cashier_payload).to_json) %>"
     data-register-workspace-settlement-value="<%= settlement_direction %>"
     data-register-workspace-refund-remaining-value="<%= remaining_refund_cents %>"
     data-register-workspace-payment-remaining-value="<%= remaining_payment_cents %>"
     data-register-workspace-cash-out-allowed-value="<%= effective_permissions.include?("gift_cards.cash_out") ? "true" : "false" %>"
     data-register-workspace-policies-value="<%= h((@control_policies || {}).to_json) %>"
     data-register-workspace-reasons-value="<%= h(Pos::ControlledActionReasons::CATALOGS.to_json) %>"
     data-register-workspace-return-reasons-value="<%= h(Pos::ReturnReasons::ENTRIES.to_json) %>"
     data-register-workspace-unlinked-lookup-url-value="<%= pos_register_unlinked_return_lookup_path(register_scope) %>"
     data-register-workspace-linked-lookup-url-value="<%= pos_register_linked_return_lookup_path(register_scope) %>"
     data-register-workspace-resolve-url-value="<%= pos_register_merchandise_resolve_path(register_scope) %>"
     data-register-workspace-search-url-value="<%= pos_register_merchandise_search_path(register_scope) %>"
     data-register-workspace-pickup-search-url-value="<%= pos_register_pickup_search_path(register_scope) %>"
     data-register-workspace-customer-search-url-value="<%= pos_register_customer_search_path(register_scope) %>"
     data-register-workspace-pickup-allowed-value="<%= @pickup_allowed ? "true" : "false" %>"
     data-register-workspace-open-price-url-value="<%= pos_register_open_price_path(register_scope) %>"
     data-action="turbo:submit-end->register-workspace#onSubmitEnd">
  <div data-register-workspace-target="chrome"></div>

    <div id="pos_feedback" class="pos-feedback" data-register-workspace-target="feedback" role="<%= @feedback.present? ? "alert" : "status" %>" aria-live="<%= @feedback.present? ? "assertive" : "polite" %>">
      <% if @ui_mode == "completion_pending" && @feedback.blank? %>
        Completing transaction…
      <% elsif @feedback.present? %>
        <%= @feedback %>
        <% if @ui_mode == "completion_failed" %>
          Tender is kept. Retry does not take it again.
        <% end %>
      <% end %>
    </div>

    <div id="pos_command" class="pos-command">
      <div class="pos-command__mode" data-register-workspace-target="modeLabel"><%= @ui_mode == "sale_entry" || @ui_mode == "quantity" ? pos_mode_label(@ui_mode) : tender_mode_label %></div>
      <label for="pos-command-field" data-register-workspace-target="fieldLabel"><%= command_label %></label>
      <input id="pos-command-field"
             class="pos-command__field"
             data-register-workspace-target="field"
             value="<%= command_value %>"
             inputmode="<%= command_inputmode %>"
             autocomplete="off"
             <%= "disabled" if locked || @ui_mode == "completion_pending" %>
             <%= "autofocus" unless locked || @ui_mode == "completion_failed" || completion_recovery %>>
      <div data-register-workspace-target="giftCardNumberWrap" hidden>
        <label for="pos-gift-card-number-field">Gift card number</label>
        <input id="pos-gift-card-number-field"
               class="pos-command__field"
               data-register-workspace-target="giftCardNumberField"
               autocomplete="off">
      </div>
      <div data-register-workspace-target="referenceWrap" <%= "hidden" unless show_reference %>>
        <label for="pos-reference-field" data-register-workspace-target="referenceLabel">
          <%= selected_tender_type&.reference_field_label || "Reference" %>
        </label>
        <input id="pos-reference-field"
               class="pos-command__field"
               data-register-workspace-target="referenceField"
               autocomplete="off">
      </div>
    </div>

    <div class="pos-main">
      <div id="pos_basket" class="pos-basket">
        <table class="pos-lines">
          <thead>
            <tr>
              <th>Qty</th>
              <th>Description</th>
              <th class="numeric">Unit</th>
              <th class="numeric">Ext</th>
            </tr>
          </thead>
          <tbody>
            <% lines.each do |line| %>
              <% original = line.original_transaction_line&.pos_transaction %>
              <tr class="<%= [ ("is-selected" if line.id == selected_id), ("is-controlled" if pos_line_controlled?(line)) ].compact.join(" ") %>"
                  data-line-id="<%= line.id %>"
                  data-quantity="<%= line.quantity %>"
                  data-description="<%= pos_line_description(line) %>"
                  data-direction="<%= line.direction %>"
                  data-linked-return="<%= line.linked_return? %>"
                  data-unit-line="<%= line.unit_line? %>"
                  data-price-overridden="<%= line.price_overridden? %>"
                  data-discounted="<%= line.manually_discounted? %>"
                  data-tax-overridden="<%= line.tax_class_overridden? %>"
                  data-selling-cents="<%= line.selling_unit_price_cents %>"
                  data-discount-bp="<%= line.manual_discount_basis_points %>"
                  data-tax-class-id="<%= line.tax_class_id %>"
                  data-pricing-method-snapshot="<%= line.pricing_method_snapshot %>"
                  aria-selected="<%= line.id == selected_id %>">
                <td><%= line.id == selected_id ? ">" : "" %> <%= line.quantity %></td>
                <td>
                  <div class="pos-line__title">
                    <%= line.return? ? "RETURN · " : "" %><%= pos_basket_line_title(line) %>
                  </div>
                  <% metadata = pos_basket_line_metadata(line) %>
                  <% if metadata.any? %>
                    <div class="pos-line__meta">
                      <% metadata.each_with_index do |part, index| %>
                        <%= " · " if index.positive? %>
                        <% if part[:mono] %>
                          <span class="pos-line__id"><%= part[:text] %></span>
                        <% else %>
                          <%= part[:text] %>
                        <% end %>
                      <% end %>
                    </div>
                  <% end %>
                  <% if pos_line_controlled?(line) %>
                    <span class="pos-line-flags"><%= pos_line_control_flags(line) %></span>
                  <% end %>
                  <% if line.linked_return? %>
                    <div class="pos-line__provenance">
                      <% if original %>From <%= original.transaction_reference %><% end %>
                      <% if line.return_reason_name_snapshot.present? %>
                        <%= original ? " · " : "" %><%= line.return_reason_name_snapshot %>
                      <% end %>
                    </div>
                  <% elsif line.unlinked_return? %>
                    <div class="pos-line__provenance">
                      Unlinked return
                      <% if line.return_reason_name_snapshot.present? %>
                        · <%= line.return_reason_name_snapshot %>
                      <% end %>
                    </div>
                    <% if pos_unlinked_return_price_adjusted?(line) %>
                      <div class="pos-line__provenance">
                        Reference <%= format_money_cents(line.reference_unit_price_cents) %>
                        · Return <%= format_money_cents(line.selling_unit_price_cents) %>
                      </div>
                    <% end %>
                  <% end %>
                </td>
                <td class="numeric"><%= format_money_cents(line.selling_unit_price_cents) %></td>
                <td class="numeric"><%= format_signed_money_cents(pos_line_amount_cents(line)) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <% if issuances.any? || (@ui_mode == "sale_entry" && gift_card_programs.any?) %>
          <section class="pos-issuances" aria-label="Gift cards">
            <h2 class="pos-issuances__title">Gift cards</h2>
            <% issuances.each do |issuance| %>
              <div class="pos-issuance">
                <%= issuance.activation? ? "Activation" : "Reload" %>
                · <%= format_money_cents(issuance.amount_cents) %>
                <% if issuance.masked_card_snapshot.present? || issuance.pending_card_number_last_four.present? %>
                  · <%= issuance.masked_card_snapshot.presence || "#{issuance.pending_card_number_prefix}••••#{issuance.pending_card_number_last_four}" %>
                <% elsif issuance.gift_card_program %>
                  · <%= issuance.gift_card_program.name %>
                <% end %>
                <% if @ui_mode == "sale_entry" %>
                  <%= button_to "Remove",
                        pos_register_remove_stored_value_issuance_path(register_scope),
                        method: :post,
                        params: { lock_version: @transaction.lock_version, register_id: @register.id, issuance_id: issuance.id },
                        form: { data: { turbo: true } },
                        class: "btn btn--ghost" %>
                <% end %>
              </div>
            <% end %>
            <% if @ui_mode == "sale_entry" && gift_card_programs.any? %>
              <%= form_with url: pos_register_stored_value_issuance_path(register_scope), method: :post, class: "pos-issuance-form" do %>
                <%= hidden_field_tag :register_id, @register.id %>
                <%= hidden_field_tag :lock_version, @transaction.lock_version %>
                <label>
                  Type
                  <select name="issuance_type">
                    <option value="activation">Activation</option>
                    <option value="reload">Reload</option>
                  </select>
                </label>
                <label>
                  Program
                  <select name="gift_card_program_id">
                    <% gift_card_programs.each do |program| %>
                      <option value="<%= program.id %>"><%= program.name %></option>
                    <% end %>
                  </select>
                </label>
                <label>
                  Amount
                  <input name="issuance_amount" inputmode="decimal" autocomplete="off">
                </label>
                <label>
                  Card number
                  <input name="card_number" autocomplete="off" data-register-workspace-target="issuanceCardNumber">
                </label>
                <%= submit_tag "Add gift card", class: "btn btn--solid btn--brand" %>
              <% end %>
            <% end %>
          </section>
        <% end %>
        <% if @transaction.customer %>
          <div class="pos-customer">
            <p>Customer · <%= @transaction.customer.display_name %></p>
            <% if @ui_mode == "sale_entry" %>
              <div class="pos-customer__actions">
                <%= action_button "Change", style: :outline, intent: :neutral, size: :standard,
                      data: { action: "register-workspace#openCustomerOverlay", register_workspace_target: "attachCustomerButton" } %>
                <%= form_with url: pos_register_detach_customer_path(register_scope), method: :post, class: "pos-customer-form" do %>
                  <%= hidden_field_tag :register_id, @register.id %>
                  <%= hidden_field_tag :lock_version, @transaction.lock_version %>
                  <%= submit_tag "Clear", class: "btn btn--outline" %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% elsif @ui_mode == "sale_entry" %>
          <div class="pos-customer">
            <%= action_button "Attach customer", style: :outline, intent: :neutral, size: :standard,
                  data: { action: "register-workspace#openCustomerOverlay", register_workspace_target: "attachCustomerButton" } %>
          </div>
        <% end %>
      </div>

      <aside id="pos_totals" class="pos-totals">
        <% if sale_lines.any? %>
          <div>Sales  <%= format_money_cents(@transaction.sale_total_cents) %></div>
          <% if @transaction.discount_cents.positive? %>
            <div>Discount  <%= format_money_cents(@transaction.discount_cents) %></div>
          <% end %>
        <% end %>
        <% if return_lines.any? %>
          <div>Returns  <%= format_signed_money_cents(-@transaction.return_total_cents) %></div>
          <% if @transaction.return_discount_cents.positive? %>
            <div>Discount reversal  <%= format_signed_money_cents(@transaction.return_discount_cents) %></div>
          <% end %>
        <% end %>
        <% if @transaction.stored_value_issuance_cents.to_i != 0 %>
          <div>Gift cards  <%= format_signed_money_cents(@transaction.stored_value_issuance_cents) %></div>
        <% end %>
        <div>Net  <%= format_signed_money_cents(@transaction.signed_net_cents) %></div>
        <% tenders.each do |working_tender| %>
          <div><%= pos_tender_label(working_tender) %>  <%= format_money_cents(working_tender.amount_cents) %></div>
        <% end %>
        <% if Pos::Support.exact_settlement?(@transaction) && tender %>
          <div>Cash presented  <%= format_money_cents(tender.amount_presented_cents) %></div>
          <div class="pos-totals__change">CHANGE  <%= format_money_cents(change_cents) %></div>
        <% elsif even_exchange && @ui_mode == "sale_entry" %>
          <div>Even exchange</div>
        <% elsif settlement_direction == :refund %>
          <div class="pos-totals__due">Refund due  <%= format_money_cents(remaining_cents) %></div>
        <% elsif settlement_direction == :payment %>
          <div class="pos-totals__due">Amount due  <%= format_money_cents(remaining_cents) %></div>
        <% end %>
      </aside>
    </div>

    <div id="pos_actions" class="pos-actions">
      <% if completion_recovery %>
        <div class="pos-actions__group" role="group" aria-label="Completion recovery">
          <%= action_button "Retry complete", style: :solid, intent: :brand, size: :large,
                data: { action: "register-workspace#submitComplete", register_workspace_target: "retry" },
                autofocus: true %>
          <%= action_button_to "Return to sale", pos_register_abandon_tender_path, style: :outline, intent: :neutral, size: :large, method: :post,
                params: { lock_version: @transaction.lock_version, register_id: @register.id },
                form: { data: { turbo: true } },
                data: { register_workspace_target: "abandonButton" } %>
        </div>
      <% else %>
        <div class="pos-actions__group" role="group" aria-label="Returns and pickup">
          <%= action_button "Return (-)", style: :outline, intent: :neutral, size: :large,
                data: { action: "register-workspace#openReturnChooser", register_workspace_target: "returnButton" } %>
          <% if @pickup_allowed %>
            <%= action_button "Pickup", style: :outline, intent: :neutral, size: :large,
                  data: { action: "register-workspace#openPickupOverlay", register_workspace_target: "pickupButton" } %>
          <% end %>
        </div>
        <div class="pos-actions__group" role="group" aria-label="Line controls">
          <%= action_button "Quantity (*)", style: :outline, intent: :neutral, size: :large, disabled: true,
                data: { action: "register-workspace#enterQuantity", register_workspace_target: "quantityButton" } %>
          <%= action_button "Price (F6)", style: :outline, intent: :neutral, size: :large, disabled: true,
                data: { action: "register-workspace#openPriceOverride", register_workspace_target: "overrideButton" } %>
          <%= action_button "Discount (F7)", style: :outline, intent: :neutral, size: :large, disabled: true,
                data: { action: "register-workspace#openLineDiscount", register_workspace_target: "discountButton" } %>
          <%= action_button "Tax Class", style: :outline, intent: :neutral, size: :large, disabled: true,
                data: { action: "register-workspace#openTaxClassOverride", register_workspace_target: "taxClassButton" } %>
        </div>
        <div class="pos-actions__group" role="group" aria-label="Tender">
          <%= action_button "Cash (F1)", style: :outline, intent: :neutral, size: :large, disabled: true,
                data: { action: "register-workspace#chooseCash", register_workspace_target: "cashButton" } %>
          <%= action_button "Card (F2)", style: :outline, intent: :neutral, size: :large, disabled: true,
                data: { action: "register-workspace#chooseCard", register_workspace_target: "cardButton" } %>
          <%= action_button "Check (F3)", style: :outline, intent: :neutral, size: :large, disabled: true,
                data: { action: "register-workspace#chooseCheck", register_workspace_target: "checkButton" } %>
          <%= action_button "Other (F4)", style: :outline, intent: :neutral, size: :large, disabled: true,
                data: { action: "register-workspace#chooseOther", register_workspace_target: "otherButton" } %>
          <%= action_button "Stored value (F5)", style: :outline, intent: :neutral, size: :large, disabled: true,
                data: { action: "register-workspace#chooseStoredValue", register_workspace_target: "storedValueButton" } %>
          <%= action_button (even_exchange ? "Complete (+)" : (refund_mode ? "Refund (+)" : "Tender (+)")),
                style: :outline, intent: :neutral, size: :large, disabled: true,
                data: { action: "register-workspace#enterTender", register_workspace_target: "tenderButton" } %>
        </div>
        <div class="pos-actions__group" role="group" aria-label="Remove line">
          <%= action_button "Remove (F8)", style: :outline, intent: :neutral, size: :large, disabled: true,
                data: { action: "register-workspace#removeSelected", register_workspace_target: "removeButton" } %>
          <% if @ui_mode == "tender" && tenders.any? %>
            <%= action_button_to "Return to sale", pos_register_abandon_tender_path, style: :outline, intent: :neutral, size: :large, method: :post,
                  params: { lock_version: @transaction.lock_version, register_id: @register.id },
                  form: { data: { turbo: true } },
                  data: { register_workspace_target: "abandonButton" } %>
          <% end %>
        </div>
      <% end %>
      <div data-register-workspace-target="clientRecovery" hidden>
        <%= action_button "Retry complete", style: :solid, intent: :brand, size: :large,
              data: { action: "register-workspace#submitComplete" } %>
      </div>
      <div class="pos-actions__group pos-actions__group--escape" role="group" aria-label="Cancel transaction">
        <%= action_button "Cancel (F9)", style: :outline, intent: :danger, size: :large, disabled: true,
              data: { action: "register-workspace#openOverlay", register_workspace_target: "cancelButton" } %>
      </div>
      <% if @ui_mode == "sale_entry" && lines.empty? && tenders.empty? && issuances.empty? %>
        <div class="pos-actions__group" role="group" aria-label="Session">
          <%= action_button_to "Close Session", pos_register_close_path, style: :outline, intent: :neutral, size: :standard, method: :post,
                params: { session_id: @session_record.id, register_id: @register.id },
                data: { register_shell_proxy: "close-session" } %>
        </div>
      <% end %>
    </div>


    <% if effective_permissions.include?("gift_cards.cash_out") %>
      <%= form_with url: lookup_pos_cash_outs_path, method: :post, local: true, html: { class: "pos-hidden", data: { register_workspace_target: "cashOutForm" } } do %>
        <%= hidden_field_tag :card_number, nil, data: { register_workspace_target: "cashOutCardInput" } %>
      <% end %>
    <% end %>

    <%= form_with url: pos_register_merchandise_path(register_scope), method: :post, html: { class: "pos-hidden", data: { register_workspace_target: "merchandiseForm", turbo: true } } do %>
      <%= hidden_field_tag :register_id, @register.id %>
      <%= hidden_field_tag :lock_version, @transaction.lock_version %>
      <%= hidden_field_tag :selected_line_id, selected_id %>
      <%= hidden_field_tag :identifier, "", data: { register_workspace_target: "identifierInput" } %>
      <%= hidden_field_tag :product_variant_id, "", data: { register_workspace_target: "variantInput" } %>
      <%= hidden_field_tag :inventory_unit_id, "", data: { register_workspace_target: "unitInput" } %>
      <%= hidden_field_tag :selling_price, "", data: { register_workspace_target: "openPriceInput" } %>
    <% end %>

    <%= form_with url: pos_register_pickup_path(register_scope), method: :post, html: { class: "pos-hidden", data: { register_workspace_target: "pickupForm", turbo: true } } do %>
      <%= hidden_field_tag :register_id, @register.id %>
      <%= hidden_field_tag :lock_version, @transaction.lock_version %>
      <%= hidden_field_tag :customer_request_id, "", data: { register_workspace_target: "pickupRequestInput" } %>
    <% end %>

    <%= form_with url: pos_register_attach_customer_path(register_scope), method: :post, html: { class: "pos-hidden", data: { register_workspace_target: "attachCustomerForm", turbo: true } } do %>
      <%= hidden_field_tag :register_id, @register.id %>
      <%= hidden_field_tag :lock_version, @transaction.lock_version %>
      <%= hidden_field_tag :customer_id, "", data: { register_workspace_target: "attachCustomerIdInput" } %>
    <% end %>

    <%= form_with url: pos_register_quantity_path(register_scope), method: :post, html: { class: "pos-hidden", data: { register_workspace_target: "quantityForm", turbo: true } } do %>
      <%= hidden_field_tag :register_id, @register.id %>
      <%= hidden_field_tag :lock_version, @transaction.lock_version %>
      <%= hidden_field_tag :line_id, selected_id, data: { register_workspace_target: "quantityLineInput" } %>
      <%= hidden_field_tag :quantity, "", data: { register_workspace_target: "quantityInput" } %>
    <% end %>

    <%= form_with url: pos_register_remove_path(register_scope), method: :post, html: { class: "pos-hidden", data: { register_workspace_target: "removeForm", turbo: true } } do %>
      <%= hidden_field_tag :register_id, @register.id %>
      <%= hidden_field_tag :lock_version, @transaction.lock_version %>
      <%= hidden_field_tag :line_id, selected_id, data: { register_workspace_target: "removeLineInput" } %>
    <% end %>

    <%= form_with url: pos_register_tender_path(register_scope), method: :post, html: { class: "pos-hidden", data: { register_workspace_target: "tenderForm", turbo: true } } do %>
      <%= hidden_field_tag :register_id, @register.id %>
      <%= hidden_field_tag :lock_version, @transaction.lock_version %>
      <%= hidden_field_tag :tender_amount, "", data: { register_workspace_target: "presentedInput" } %>
      <%= hidden_field_tag :tender_type_id, selected_tender_type&.id, data: { register_workspace_target: "tenderTypeInput" } %>
