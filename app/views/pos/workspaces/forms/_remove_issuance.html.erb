<%= form_with url: pos_register_remove_stored_value_issuance_path(register_scope), method: :post, html: { class: "pos-hidden", data: { register_workspace_target: "removeIssuanceForm", turbo: true } } do %>
  <%= hidden_field_tag :register_id, @register.id %>
  <%= hidden_field_tag :lock_version, @transaction.lock_version %>
  <%= hidden_field_tag :issuance_id, "", data: { register_workspace_target: "removeIssuanceIdInput" } %>
  <%= hidden_field_tag :operation_id, "", data: { register_workspace_target: "removeIssuanceOperationInput" } %>
  <%= hidden_field_tag :confirm_clear_tenders, "", data: { register_workspace_target: "removeIssuanceConfirmClearInput" } %>
<% end %>
