<% content_for :title, "Z report" %>

<main class="pos-z" data-controller="pos-receipt">
  <div class="pos-no-print">
    <%= render "pos/shared/report_nav" %>

    <h1>Z report</h1>
    <p>Store  <%= pos_padded_store_number(@period.store) %></p>
    <p>Register  <%= pos_padded_register_number(@register) %></p>
    <p>Business date  <%= @period.business_date.iso8601 %></p>
    <p>Finalized  <%= format_store_timestamp(@period.closed_at, @period.store) %></p>
    <p>Finalized by  <%= @period.finalized_by.display_name %></p>

    <%= render "pos/shared/totals_groups", groups: @report_groups %>

    <div class="pos-z__actions">
      <button type="button" class="btn" data-action="pos-receipt#print">Print</button>
    </div>
  </div>

  <%= render "pos/shared/report_print",
        title: "Z report",
        banners: [],
        meta: [
          "Store  #{pos_padded_store_number(@period.store)}",
          "Register  #{pos_padded_register_number(@register)}",
          "Business date  #{@period.business_date.iso8601}",
          "Finalized  #{format_store_timestamp(@period.closed_at, @period.store)}",
          "Finalized by  #{@period.finalized_by.display_name}"
        ],
        groups: @report_groups %>
</main>
