<% content_for :title, "Finalize Z" %>
<%= render layout: "pos/shell/frame" do %>
  <%= render "pos/shell/feedback" %>
  <div class="pos-register-shell__body">
    <main class="pos-history">
      <div class="pos-history__title-row pos-no-print">
        <h1>Finalize Z</h1>
        <%= link_to register_inquiry_return_label, register_inquiry_return_path, class: "btn btn--ghost" %>
      </div>

      <dl class="pos-history__header">
        <div><dt>Store</dt><dd><%= pos_padded_store_number(@period.store) %></dd></div>
        <div><dt>Register</dt><dd><%= pos_padded_register_number(@register) %></dd></div>
        <div><dt>Business date</dt><dd><%= @period.business_date.iso8601 %></dd></div>
      </dl>

      <section aria-label="Finalize blockers">
        <h2>Confirmation</h2>
        <p>Finalizing creates one immutable Z snapshot for this reporting period.</p>
        <% if @finalize.blockers.any? %>
          <ul role="list">
            <% @finalize.blockers.each do |blocker| %>
              <li role="alert"><%= blocker %></li>
            <% end %>
          </ul>
        <% end %>
        <% @finalize.warnings.each do |warning| %>
          <p role="status"><%= warning %></p>
        <% end %>
      </section>

      <div class="pos-no-print">
        <%= render "pos/shared/totals_groups", groups: @report_groups %>
      </div>

      <div class="pos-history__nav pos-no-print actions">
        <%= link_to "Back to Z status", pos_reporting_period_status_path(@period), class: "btn btn--secondary" %>
        <% if @finalize.ready? %>
          <%= form_with url: pos_reporting_period_finalize_path(@period), method: :post do %>
            <%= hidden_field_tag :expected_lock_version, @period.lock_version %>
            <%= hidden_field_tag :return_to, "confirm" %>
            <%= hidden_field_tag :register_id, @register.id %>
            <%= submit_tag "Finalize Z", class: "btn" %>
          <% end %>
        <% end %>
      </div>
    </main>
  </div>
<% end %>
