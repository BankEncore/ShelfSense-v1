<%#
  locals:
    headers: array of strings or {
      text:,
      class:        # compatibility alias applied to both th and td (e.g. numeric)
      header_class: # th only
      cell_class:   # td only (content roles: cell-primary / cell-secondary / cell-identifier)
    }
    rows: array of arrays of cell content (HTML-safe ok)
    empty: optional HTML when no rows
%>
<% if rows.blank? %>
  <%= local_assigns[:empty] %>
<% else %>
  <div class="table-scroll">
    <table class="data-table">
      <thead>
        <tr>
          <% headers.each do |header| %>
            <% if header.is_a?(Hash) %>
              <% header_class = [header[:header_class], header[:class]].compact_blank.join(" ") %>
              <th class="<%= header_class %>"><%= header[:text] %></th>
            <% else %>
              <th><%= header %></th>
            <% end %>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |row| %>
          <tr>
            <% row.each_with_index do |cell, index| %>
              <% header = headers[index] %>
              <% cell_class = header.is_a?(Hash) ? [header[:cell_class], header[:class]].compact_blank.join(" ") : nil %>
              <td class="<%= cell_class %>"><%= cell %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
