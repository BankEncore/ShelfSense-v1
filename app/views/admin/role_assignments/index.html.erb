<% content_for :title, "Role assignments" %>
<h1>Role assignments</h1>
<p><%= action_link_to("Assign role", new_admin_role_assignment_path, style: :solid, intent: :brand) %></p>
<ul>
  <% @role_assignments.each do |assignment| %>
    <li>
      <%= assignment.user.username %> → <%= assignment.role.key %>
      <%= assignment.store ? " @ #{assignment.store.admin_label}" : " (global)" %>
      <%= "revoked" if assignment.revoked? %>
      <% unless assignment.revoked? %>
        <%= action_button_to("Revoke", admin_role_assignment_path(assignment), style: :outline, intent: :warning, method: :delete) %>
      <% end %>
    </li>
  <% end %>
</ul>
