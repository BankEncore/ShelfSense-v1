<% content_for :title, @merchandise_condition.admin_label %>
<h1><%= @merchandise_condition.admin_label %></h1>
<p>
  Code: <%= @merchandise_condition.code %> ·
  Price adjustment bps: <%= @merchandise_condition.price_adjustment_bps %> ·
  Order: <%= @merchandise_condition.display_order %> ·
  <%= @merchandise_condition.active? ? "active" : "inactive" %>
</p>
<% if @merchandise_condition.description.present? %><p><%= @merchandise_condition.description %></p><% end %>
<p>
  <%= action_link_to("Edit", edit_admin_merchandise_condition_path(@merchandise_condition), style: :outline, intent: :neutral) if effective_permissions.include?("merchandise_conditions.update") %>
  <% if effective_permissions.include?("merchandise_conditions.deactivate") && @merchandise_condition.active? %>
    <%= action_button_to(
          "Deactivate",
          admin_merchandise_condition_path(@merchandise_condition),
          style: :outline,
          intent: :warning,
          method: :delete,
          form: { data: { turbo_confirm: "Deactivate this condition?" } }
        ) %>
  <% elsif effective_permissions.include?("merchandise_conditions.deactivate") && !@merchandise_condition.active? %>
    <%= action_button_to(
          "Reactivate",
          reactivate_admin_merchandise_condition_path(@merchandise_condition),
          style: :solid,
          intent: :brand,
          method: :post,
          params: { lock_version: @merchandise_condition.lock_version }
        ) %>
  <% end %>
</p>
<p><%= action_link_to("Back to conditions", admin_merchandise_conditions_path, style: :link, intent: :neutral) %></p>
