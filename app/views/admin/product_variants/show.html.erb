<% content_for :title, @product_variant.name.presence || @product_variant.sku %>

<%= render "shared/breadcrumbs", crumbs: [
  { name: "Home", path: root_path },
  { name: "Products", path: admin_products_path },
  { name: @product_variant.product.name, path: admin_product_path(@product_variant.product) },
  { name: @product_variant.name.presence || @product_variant.sku }
] %>

<% actions = [status_badge(@product_variant.status, scheme: :product_variant)] %>
<% if effective_permissions.include?("product_variants.update") %>
  <% actions << action_link_to(
       "Edit",
       edit_admin_product_variant_path(@product_variant),
       style: :outline,
       intent: :neutral
     ) %>
<% end %>
<% if effective_permissions.include?("product_variants.discontinue") && @product_variant.status != "discontinued" %>
  <% actions << action_button_to(
       "Discontinue",
       discontinue_admin_product_variant_path(@product_variant),
       style: :outline,
       intent: :danger,
       method: :post
     ) %>
<% end %>
<% if effective_permissions.include?("product_variants.update") && @product_variant.draft? %>
  <% actions << action_button_to(
       "Delete draft",
       admin_product_variant_path(@product_variant),
       style: :outline,
       intent: :danger,
       method: :delete
     ) %>
<% end %>
<% if @show_inventory %>
  <% if @inventory_balance %>
    <% actions << action_link_to(
         "View inventory",
         admin_inventory_balance_path(@inventory_balance),
         style: :outline,
         intent: :neutral
       ) %>
  <% end %>
  <% if effective_permissions.include?("inventory.adjust") && current_store %>
    <% actions << action_link_to(
         "Adjust inventory",
         new_admin_inventory_adjustment_path(store_id: current_store.id, product_variant_id: @product_variant.id),
         style: :outline,
         intent: :neutral
       ) %>
  <% end %>
<% end %>
<% if @can_order_stock %>
  <% actions << action_link_to("Order stock", order_stock_path_for(@product_variant), style: :solid, intent: :brand) %>
<% end %>
<% if @can_create_customer_request %>
  <% actions << action_link_to(
       "Create customer request",
       create_customer_request_path_for(@product_variant),
       style: :outline,
       intent: :neutral
     ) %>
<% end %>

<%= render "shared/page_header",
      title: @product_variant.name.presence || "Variant",
      subtitle: "SKU #{@product_variant.sku}",
      actions: safe_join(actions, " ") %>

<section class="section surface">
  <%= render "shared/definition_list", rows: [
        ["Product", (
          admin_product_link(@product_variant.product) || @product_variant.product.name
        )],
        ["SKU", @product_variant.sku],
        ["Type", @product_variant.variant_type.humanize],
        ["Status", status_badge(@product_variant.status, scheme: :product_variant)],
        ["Regular price", format_money_cents(@product_variant.regular_price_cents)],
        ["Merchandise class", (
          admin_merchandise_class_link(@product_variant.merchandise_class) ||
            @product_variant.merchandise_class&.admin_label
        )],
        ["Department", (
          admin_department_link(@product_variant.department) ||
            @product_variant.department&.admin_label
        )],
        ["Effective tax class", (
          admin_tax_class_link(@product_variant.effective_tax_class) ||
            @product_variant.effective_tax_class&.admin_label
        )],
        ["Tax class override", (
          admin_tax_class_link(@product_variant.tax_class_override) ||
            @product_variant.tax_class_override&.admin_label
        )],
        ["Condition", @product_variant.merchandise_condition&.admin_label],
        ["Industry identifier", @product_variant.industry_identifier]
      ] %>
</section>

<% if current_store.present? && (@product_variant.standard? || @product_variant.used?) && @product_variant.status == "active" %>
  <section class="section surface">
    <h2>Store operations</h2>
    <% if @product_variant.standard? %>
      <%= render "shared/definition_list", rows: [
            ["On hand", @inventory_balance&.on_hand_quantity || 0],
            ["Reserved", @reserved_quantity || 0],
            ["Available", @available_quantity || 0],
            ["Open stock orders", @open_stock_order_quantity || 0],
            ["Open customer special orders", @open_customer_order_quantity || 0],
            ["Preferred supplier", @preferred_source&.supplier&.admin_label || "—"],
            ["Preferred expected cost", (
              cost = @preferred_source&.derived_expected_unit_cost_cents
              cost ? format_money_cents(cost) : "—"
            )]
          ] %>
    <% else %>
      <%= render "shared/definition_list", rows: [
            ["On hand units", @on_hand_units&.size || 0],
            ["Unreserved units (requestable)", (
              current_store ? Inventory::Availability.unreserved_on_hand_units(current_store, @product_variant).count : 0
            )]
          ] %>
    <% end %>
    <% unless current_store.present? %>
      <p class="muted">Select a store to order stock or create customer requests.</p>
    <% end %>
  </section>
<% elsif current_store.blank? && (@can_order_stock || effective_permissions.include?("orders.manage") || effective_permissions.include?("customer_requests.manage")) %>
  <section class="section surface">
    <p class="muted">Select a store to order stock or create customer requests for this variant.</p>
  </section>
<% end %>

<% if @supplier_variant_sources %>
  <section class="section surface">
    <h2>Supplier sources</h2>
    <p class="muted">
      Organization preferred is the default for all stores. A store preference overrides it for the selected store.
    </p>
    <% if @can_manage_supplier_sources %>
      <div class="actions">
        <%= action_link_to(
              "Add supplier source",
              new_admin_product_variant_supplier_variant_source_path(@product_variant),
              style: :outline,
              intent: :neutral
            ) %>
      </div>
    <% end %>

    <% if @supplier_variant_sources.empty? %>
      <%= render "shared/empty_state",
            title: "No supplier sources",
            body: "Add a supplier source to set preferred cost and default ordering supplier for this variant." %>
    <% else %>
      <% source_rows = @supplier_variant_sources.map { |source|
           cost = source.derived_expected_unit_cost_cents
           badges = []
           badges << "org preferred" if source.organization_preferred? && source.active?
           if current_store && @store_source_preference&.supplier_variant_source_id == source.id
             badges << "store preferred"
           end
           badges << "inactive" unless source.active?
           actions = []
           actions << action_link_to(
             "View",
             admin_supplier_variant_source_path(source, return_to: "variant"),
             style: :outline,
             intent: :neutral,
             size: :small
           )
           if @can_manage_supplier_sources
             actions << action_link_to(
               "Edit",
               edit_admin_supplier_variant_source_path(source, return_to: "variant"),
               style: :outline,
               intent: :neutral,
               size: :small
             )
             if source.active?
               actions << action_button_to(
                 "Remove",
                 admin_supplier_variant_source_path(source, return_to: "variant"),
                 style: :outline,
                 intent: :danger,
                 size: :small,
                 method: :delete,
                 form: { data: { turbo_confirm: "Deactivate this supplier source?" } }
               )
               if current_store
                 if @store_source_preference&.supplier_variant_source_id == source.id
                   actions << action_button_to(
                     "Clear store preferred",
                     admin_store_supplier_source_preference_path(@store_source_preference, return_to: "variant"),
                     style: :outline,
                     intent: :neutral,
                     size: :small,
                     method: :delete,
                     form: { data: { turbo_confirm: "Clear this store preference?" } }
                   )
                 else
                   actions << action_button_to(
                     "Set store preferred",
                     admin_supplier_variant_source_store_supplier_source_preferences_path(source, return_to: "variant"),
                     style: :outline,
                     intent: :neutral,
                     size: :small,
                     method: :post,
                     params: { store_supplier_source_preference: { store_id: current_store.id } }
                   )
                 end
               end
             else
               actions << action_button_to(
                 "Reactivate",
                 reactivate_admin_supplier_variant_source_path(source, return_to: "variant"),
                 style: :solid,
                 intent: :brand,
                 size: :small,
                 method: :post,
                 params: { lock_version: source.lock_version }
               )
             end
           end
           [
             link_to(source.supplier.admin_label, admin_supplier_path(source.supplier)),
             source.supplier_item_number.presence || "—",
             source.pricing_method.humanize,
             cost ? format_money_cents(cost) : "—",
             badges.empty? ? "—" : badges.join(" · "),
             safe_join(actions, " ")
           ]
         } %>
      <%= render "shared/data_table",
            headers: [
              "Supplier",
              "Supplier item #",
              "Pricing",
              { text: "Expected cost", class: "numeric" },
              "Preference",
              "Actions"
            ],
            rows: source_rows %>
      <% if current_store.blank? && @can_manage_supplier_sources %>
        <p class="muted">Select a store to set or clear a store-level preferred source.</p>
      <% end %>
    <% end %>
  </section>
<% end %>

<% if @show_inventory %>
  <% tracking = @product_variant.derived_inventory_tracking %>
  <% balance = @inventory_balance %>
  <section class="section surface">
    <h2>Inventory</h2>
    <% if tracking.blank? || tracking == "non_inventory" %>
      <%= render "shared/definition_list", rows: [
            ["Tracking", tracking.present? ? tracking.humanize : "—"],
            ["On hand", "—"]
          ] %>
    <% else %>
      <% avg = balance&.derived_average_unit_cost %>
      <%= render "shared/definition_list", rows: [
            ["Store", current_store.name],
            ["Tracking", tracking.humanize],
            ["On hand", (
              if balance
                admin_inventory_balance_link(balance, label: balance.on_hand_quantity.to_s) ||
                  balance.on_hand_quantity
              else
                0
              end
            )],
            ["Carrying value", format_money_cents(balance&.inventory_value_cents || 0)],
            (tracking == "quantity" ? ["Average unit cost", (avg ? format_money_cents(avg.round) : "—")] : nil)
          ].compact %>
    <% end %>
  </section>

  <% if tracking == "individual" %>
    <section class="section surface">
      <h2>On-hand units</h2>
      <% if @on_hand_units.blank? %>
        <%= render "shared/empty_state",
              title: "No on-hand units",
              body: "No on-hand units at this store." %>
      <% else %>
        <% unit_rows = @on_hand_units.map { |unit|
             [
               balance ? (admin_inventory_balance_link(balance, label: unit.unit_identifier) || unit.unit_identifier) : unit.unit_identifier,
               format_money_cents(unit.acquisition_cost_cents),
               format_money_cents(unit.carrying_value_cents),
               format_money_cents(unit.effective_regular_price_cents),
               unit.notes.presence || missing_value
             ]
           } %>
        <%= render "shared/data_table",
              headers: [
                "Identifier",
                { text: "Acquisition cost", class: "numeric" },
                { text: "Carrying cost", class: "numeric" },
                { text: "Regular price", class: "numeric" },
                "Notes"
              ],
              rows: unit_rows %>
      <% end %>
    </section>
  <% end %>
<% end %>

<%= render "shared/technical_details", rows: [
      ["ID", @product_variant.id],
      ["Created", format_timestamp(@product_variant.created_at)],
      ["Updated", format_timestamp(@product_variant.updated_at)],
      ["Lock version", @product_variant.lock_version]
    ] %>
