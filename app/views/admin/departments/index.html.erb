<% content_for :title, "Departments" %>
<h1>Departments</h1>
<% if effective_permissions.include?("departments.create") %><p><%= action_link_to("New department", new_admin_department_path, style: :solid, intent: :brand) %></p><% end %>
<ul>
  <% @departments.each do |department| %>
    <li>
      <%= link_to department.admin_label, admin_department_path(department) %>
      <%= "inactive" unless department.active? %>
    </li>
  <% end %>
</ul>
