<% content_for :title, "Confirm inventory adjustment" %>

<%= render "shared/breadcrumbs", crumbs: [
  { name: "Home", path: root_path },
  { name: "Inventory", path: admin_inventory_balances_path },
  { name: "Confirm" }
] %>

<%= render "shared/page_header", title: "Confirm adjustment" %>

<section class="section surface">
  <%= render "shared/definition_list", rows: [
        ["Tracking", @preview[:tracking].to_s.humanize],
        ["Quantity delta", @preview[:quantity_delta]],
        ["Value delta", format_money_cents(@preview[:value_delta_cents])],
        ["Resulting on hand", @preview[:resulting_on_hand]],
        ["Resulting value", format_money_cents(@preview[:resulting_value_cents])],
        ["Business date", @preview[:business_date]],
        ["Occurred at", format_timestamp(@preview[:occurred_at])]
      ] %>
</section>

<%= form_with url: admin_inventory_adjustments_path, method: :post, local: true, class: "form" do |form| %>
  <% @form.each do |key, value| %>
    <%= hidden_field_tag key, value %>
  <% end %>
  <div class="actions">
    <%= action_submit(form, "Post adjustment", style: :solid, intent: :brand) %>
    <%= action_link_to(
          "Cancel",
          new_admin_inventory_adjustment_path(product_variant_id: @form[:product_variant_id], store_id: @form[:store_id]),
          style: :ghost,
          intent: :neutral
        ) %>
  </div>
<% end %>
