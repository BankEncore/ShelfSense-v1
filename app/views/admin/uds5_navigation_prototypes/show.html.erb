<% content_for :title, "UDS-5.0 navigation prototype" %>

<%= render "shared/page_header",
      title: "UDS-5.0 compact navigation prototype",
      subtitle: "Disposable comparison of the live grouped catalog. Production header above is unchanged expanded nav. Measure .uds-5-nav-prototype, not .app-header." %>

<p class="uds-5-nav-prototype__note">
  This route is not a catalog destination. Variants reuse
  <code>Admin::NavigationCatalog</code> / <code>Admin::NavigationViewModel</code>
  without changing membership, predicates, or labels. Native
  <code>&lt;details&gt;</code> keep every destination in the DOM with JavaScript disabled.
</p>

<nav class="uds-5-nav-prototype__switcher" aria-label="Prototype variants">
  <p>
    Variant:
    <% Admin::Uds5NavigationPrototypesController::VARIANTS.each do |variant| %>
      <%= link_to variant.tr("_", " "),
            admin_uds5_navigation_prototype_path(variant: variant, as_controller: @as_controller),
            class: ("is-active" if variant == @variant),
            "aria-current": (variant == @variant ? "page" : nil) %>
    <% end %>
  </p>
  <p>
    Simulate current controller:
    <%= link_to "Products", admin_uds5_navigation_prototype_path(variant: @variant, as_controller: "admin/products") %>
    <%= link_to "Purchasing hub", admin_uds5_navigation_prototype_path(variant: @variant, as_controller: "admin/purchasing") %>
    <%= link_to "Users", admin_uds5_navigation_prototype_path(variant: @variant, as_controller: "admin/users") %>
    <%= link_to "None", admin_uds5_navigation_prototype_path(variant: @variant, as_controller: "") %>
  </p>
  <p class="muted">Current simulation: <code><%= @as_controller.presence || "(none)" %></code> · variant <code><%= @variant %></code></p>
</nav>

<%= render "admin/uds5_navigation_prototypes/nav", nav: @prototype_nav, variant: @variant %>
