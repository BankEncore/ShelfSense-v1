<%= form_with model: [:admin, product], class: "form" do |form| %>
  <%= render "shared/form_errors", record: product, attribute_ids: { list_price: "product_list_price" } %>
  <%= form.hidden_field :lock_version %>
  <% if local_assigns[:candidate] %>
    <%= hidden_field_tag :candidate_id, candidate.candidate_id %>
  <% end %>
  <% if local_assigns[:require_create_confirmation] %>
    <div class="form-field">
      <label for="confirm_create_separately">
        <%= check_box_tag :confirm_create_separately, "1", params[:confirm_create_separately] == "1", id: "confirm_create_separately" %>
        Create as a new product
      </label>
    </div>
  <% end %>

  <%= render layout: "shared/form_section", locals: { title: "Identity", help: "ShelfSense assigns every product an immutable generated 222 primary identifier. Record the manufacturer GTIN and an optional lookup code here." } do %>
    <% if creating %>
      <div class="form-field">
        <span class="muted">Primary identifier</span>
        <div>Generated on save (reserved <code>222</code> namespace)</div>
      </div>
    <% else %>
      <div class="form-field">
        <span class="muted">Primary identifier</span>
        <div><code><%= product.primary_identifier %></code> (immutable)</div>
      </div>
    <% end %>

    <div class="form-field">
      <%= form.label :industry_identifier, "Industry identifier (GTIN / ISBN / UPC)" %>
      <%= form.text_field :industry_identifier,
            id: "product_industry_identifier",
            "aria-describedby": "product_industry_identifier_help" %>
      <span class="field-help" id="product_industry_identifier_help">Optional manufacturer identifier for this product. ISBN-10 becomes a Bookland 978 ISBN-13 and UPC-A becomes a GTIN-13; spaces and hyphens are removed. May not use the reserved 222 namespace. Clear the field to retire it.</span>
      <% if product.errors[:industry_identifier].any? %><span class="field-error"><%= product.errors[:industry_identifier].to_sentence %></span><% end %>
    </div>

    <div class="form-field">
      <%= form.label :lookup_code, "Lookup code" %>
      <%= form.text_field :lookup_code, id: "product_lookup_code", "aria-describedby": "product_lookup_code_help" %>
      <span class="field-help" id="product_lookup_code_help">Optional shelf or search code, stored uppercase. Allowed characters: A–Z, 0–9, period, underscore, slash, and hyphen; no spaces; up to 64 characters. Lookup codes are not unique — if another product uses the same code, scan and add will ask the cashier to choose a product.</span>
      <% if product.errors[:lookup_code].any? %><span class="field-error"><%= product.errors[:lookup_code].to_sentence %></span><% end %>
    </div>

    <div class="form-field">
      <%= form.label :name %>
      <%= form.text_field :name, id: "product_name", required: true, "aria-describedby": product.errors[:name].any? ? "product_name_error" : nil %>
      <% if product.errors[:name].any? %><span class="field-error" id="product_name_error"><%= product.errors[:name].to_sentence %></span><% end %>
    </div>
    <div class="form-field">
      <%= form.label :subtitle %>
      <%= form.text_field :subtitle %>
    </div>
    <div class="form-field">
      <%= form.label :description %>
      <%= form.text_area :description, rows: 4 %>
    </div>
    <div class="form-field">
      <%= form.label :brand_name, local_assigns[:candidate] ? "Publisher" : product.brand_name_label %>
      <%= form.text_field :brand_name %>
    </div>
    <div class="form-field">
      <%= form.label :product_model, "Edition / model" %>
      <%= form.text_field :product_model %>
    </div>
    <div class="form-field">
      <%= form.label :release_date %>
      <%= form.date_field :release_date %>
    </div>
    <div class="form-field">
      <%= form.check_box :release_date_approximate %>
      <%= form.label :release_date_approximate, "Approximate date" %>
    </div>
    <div class="form-field">
      <%= form.label :variant_option_name_1, "Variant option name 1" %>
      <%= form.text_field :variant_option_name_1 %>
    </div>
    <div class="form-field">
      <%= form.label :variant_option_name_2, "Variant option name 2" %>
      <%= form.text_field :variant_option_name_2 %>
    </div>
  <% end %>

  <%= render layout: "shared/form_section", locals: { title: "Bibliographic details", help: "Optional bookstore metadata. Leave blank for sidelines and other non-book merchandise." } do %>
    <div class="form-field">
      <%= form.label :product_form_id, "Product form" %>
      <%= form.select :product_form_id, @product_forms || [], include_blank: "None" %>
    </div>
    <div class="form-field">
      <%= form.label :imprint %>
      <%= form.text_field :imprint %>
    </div>
    <div class="form-field">
      <%= form.label :language_code, "Language" %>
      <%= form.text_field :language_code %>
    </div>
    <div class="form-field">
      <%= form.label :page_count, "Pages" %>
      <%= form.number_field :page_count, min: 1 %>
    </div>
    <div class="form-field">
      <%= form.label :series_name, "Series" %>
      <%= form.text_field :series_name %>
    </div>
    <div class="form-field">
      <%= form.label :series_position, "Series position" %>
      <%= form.number_field :series_position, step: 0.001 %>
    </div>
    <% contribution_rows = Array(product.contribution_rows.presence || product.product_contributions.map { |row|
         { "display_name" => row.display_name, "role" => row.role }
       }) %>
    <% contribution_rows += [ {} ] while contribution_rows.length < 3 %>
    <fieldset class="form-field">
      <legend>Contributors</legend>
      <% contribution_rows.each_with_index do |row, index| %>
        <% row = row.stringify_keys %>
        <div class="form-field">
          <%= text_field_tag "product[contribution_rows][#{index}][display_name]", row["display_name"], placeholder: "Name" %>
          <%= select_tag "product[contribution_rows][#{index}][role]",
                options_for_select(ProductContribution::ROLES.map { |role| [ role.humanize, role ] }, row["role"] || "author") %>
        </div>
      <% end %>
    </fieldset>
    <% subject_rows = Array(product.subject_rows.presence || product.product_subject_assignments.map { |row|
         { "subject_heading_id" => row.subject_heading_id, "primary" => row.primary }
       }) %>
    <% subject_rows += [ {} ] while subject_rows.length < 3 %>
    <fieldset class="form-field">
      <legend>Subjects</legend>
      <p class="field-help">Product screens show heading names. At most one primary heading per scheme.</p>
      <% headings = Array(@subject_headings) %>
      <% subject_rows.each_with_index do |row, index| %>
        <% row = row.stringify_keys %>
        <div class="form-field">
          <%= select_tag "product[subject_rows][#{index}][subject_heading_id]",
                options_from_collection_for_select(headings, :id, :admin_label, row["subject_heading_id"]),
                include_blank: "None" %>
          <label>
            <%= hidden_field_tag "product[subject_rows][#{index}][primary]", "0", id: "product_subject_rows_#{index}_primary_default" %>
            <%= check_box_tag "product[subject_rows][#{index}][primary]", "1", ActiveModel::Type::Boolean.new.cast(row["primary"]) == true, id: "product_subject_rows_#{index}_primary" %>
            Primary for scheme
          </label>
        </div>
      <% end %>
    </fieldset>
    <div class="form-field">
      <%= form.label :cover_image, "Cover image" %>
      <% if product.cover_image.attached? %>
        <div><%= image_tag product.cover_image, alt: "Current cover", class: "product-cover product-cover--thumb" %></div>
      <% end %>
      <%= form.file_field :cover_image, accept: "image/jpeg,image/png,image/gif,image/webp" %>
    </div>
  <% end %>

  <%= render layout: "shared/form_section", locals: { title: "Classification", help: "Merchandise category supplies the default merchandise class for newly created variants. Changing it does not rewrite existing variants." } do %>
    <div class="form-field">
      <%= form.label :merchandise_category_id, "Merchandise category" %>
      <%= form.select :merchandise_category_id, MerchandiseCategory.options_for_select(@merchandise_categories), include_blank: "None" %>
    </div>
  <% end %>

  <%= render layout: "shared/form_section", locals: { title: "Pricing", help: "Product-level reference price. Changing it does not rewrite existing variant prices." } do %>
    <%= render "shared/currency_field",
          name: "product[list_price]",
          id: "product_list_price",
          label: "List price",
          value: params.dig(:product, :list_price).presence || money_field_value(product.list_price_cents),
          help: "Enter a currency amount such as 12.50. Stored as integer cents.",
          error: product.errors[:list_price].presence&.to_sentence %>
  <% end %>

  <%= render layout: "shared/form_section", locals: { title: "Lifecycle" } do %>
    <div class="form-field">
      <%= form.label :status %>
      <% if product.status == "discontinued" %>
        <div><%= status_badge(product.status, scheme: :product_variant) %></div>
        <span class="field-help">Use Reactivate on the product page to restore an active status.</span>
      <% else %>
        <%= form.select :status, Product::STATUSES.reject { |s| s == "discontinued" }.map { |s| [s.humanize, s] } %>
        <span class="field-help">Use Discontinue on the product page to mark a product discontinued.</span>
      <% end %>
    </div>
  <% end %>

  <div class="actions">
    <%= action_submit(
          form,
          form.object.new_record? ? "Create Product" : "Save Product",
          style: :solid,
          intent: :brand
        ) %>
    <%= action_link_to(
          "Cancel",
          creating ? admin_products_path : admin_product_path(product),
          style: :ghost,
          intent: :neutral
        ) %>
  </div>
<% end %>
