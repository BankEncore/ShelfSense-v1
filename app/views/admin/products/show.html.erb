<% content_for :title, @product.name %>

<%= render "shared/breadcrumbs", crumbs: [
  { name: "Home", path: root_path },
  { name: "Products", path: admin_products_path },
  { name: @product.name }
] %>

<% actions = [] %>
<% actions << status_badge(@product.status, scheme: :product_variant) %>
<% if effective_permissions.include?("products.update") %>
  <% actions << action_link_to("Edit", edit_admin_product_path(@product), style: :outline, intent: :neutral) %>
<% end %>
<% if effective_permissions.include?("products.discontinue") && @product.status != "discontinued" %>
  <% actions << action_button_to(
       "Discontinue",
       discontinue_admin_product_path(@product),
       style: :outline,
       intent: :warning,
       method: :post
     ) %>
<% end %>
<% if effective_permissions.include?("products.discontinue") && @product.status == "discontinued" %>
  <% actions << action_button_to(
       "Reactivate",
       reactivate_admin_product_path(@product),
       style: :solid,
       intent: :brand,
       method: :post
     ) %>
<% end %>
<% if effective_permissions.include?("products.update") && @product.draft? %>
  <% actions << action_button_to(
       "Delete draft",
       admin_product_path(@product),
       style: :outline,
       intent: :danger,
       method: :delete
     ) %>
<% end %>
<% if @single_stock_orderable %>
  <% actions << action_link_to("Order stock", order_stock_path_for(@single_stock_orderable), style: :solid, intent: :brand) %>
<% end %>
<% if @single_requestable %>
  <% actions << action_link_to(
       "Create customer request",
       create_customer_request_path_for(@single_requestable),
       style: :outline,
       intent: :neutral
     ) %>
<% end %>

<% contributor_credits = product_contributor_credits(@product) %>
<% subtitle_parts = [] %>
<% if contributor_credits.any? %>
  <% subtitle_parts << tag.span(contributor_credits.join(", "), class: "product-identity__contributors") %>
<% end %>
<% subtitle_parts << "Primary identifier #{@product.primary_identifier}" %>
<% cover_url = @product.cover_image.attached? ? url_for(@product.cover_image) : https_image_url(@product.try(:cover_image_url)) %>
<% identity_rows = compact_definition_rows([
     ["Industry identifier (GTIN / ISBN / UPC)", @product.industry_identifier],
     ["Lookup code", (
       if @product.lookup_code.present?
         shared = Product.where(lookup_code: @product.lookup_code).where.not(id: @product.id).count
         if shared.positive?
           safe_join([@product.lookup_code, tag.span(" · shared with #{shared} other #{"product".pluralize(shared)}; scan and add will require product selection", class: "muted")])
         else
           @product.lookup_code
         end
       end
     )],
     ["Merchandise category", (
       admin_merchandise_category_link(@product.merchandise_category) ||
         @product.merchandise_category&.admin_label
     )],
     ["Subtitle", @product.subtitle],
     ["Publisher / brand / manufacturer", @product.brand_name],
     ["Edition / model", @product.product_model],
     ["Product form", @product.product_form&.name],
     ["Binding (legacy)", @product.try(:binding_legacy)],
     ["Variant options", [ @product.variant_option_name_1, @product.variant_option_name_2 ].compact_blank.join(" · ").presence]
   ]) %>
<% publication_rows = compact_definition_rows([
     ["Imprint", @product.imprint],
     ["Language", @product.language_code],
     ["Pages", @product.page_count],
     ["Series", [ @product.series_name, @product.series_position ].compact_blank.join(" · ").presence],
     ["Subjects", @product.subject_headings.map(&:name).join(", ").presence],
     ["Release date", (
       if @product.release_date.present?
         text = format_date(@product.release_date)
         @product.release_date_approximate? ? "#{text} (approximate)" : text
       end
     )]
   ]) %>
<% can_refresh = effective_permissions.include?("products.update") &&
     (@product.industry_identifier.present? || @product.bibliographic_provider_key.present?) %>
<% variant_active = @product_variants.count { |variant| variant.status == "active" } %>
<% variant_draft = @product_variants.count { |variant| variant.status == "draft" } %>
<% variant_note = [ ("#{variant_active} active" if variant_active.positive?),
                    ("#{variant_draft} draft" if variant_draft.positive?) ].compact.join(" · ").presence %>

<div class="product-identity">
  <% if cover_url %>
    <%= image_tag cover_url, alt: "Cover", class: "product-cover" %>
  <% end %>
  <div class="product-identity__heading">
    <%= render "shared/page_header",
          title: @product.name,
          subtitle: safe_join(subtitle_parts, tag.br),
          actions: safe_join(actions, " ") %>
  </div>
</div>

<section class="surface product-summary" aria-label="Product summary">
  <div class="product-summary__cell">
    <span class="product-summary__label">Primary identifier</span>
    <span class="product-summary__value"><%= @product.primary_identifier %></span>
  </div>
  <div class="product-summary__cell">
    <span class="product-summary__label">List price</span>
    <span class="product-summary__value"><%= format_money_cents(@product.list_price_cents) %></span>
  </div>
  <div class="product-summary__cell">
    <span class="product-summary__label">Variants</span>
    <span class="product-summary__value"><%= @product_variants.size %></span>
    <% if variant_note %>
      <span class="product-summary__note"><%= variant_note %></span>
    <% end %>
  </div>
  <% if @show_inventory %>
    <div class="product-summary__cell">
      <span class="product-summary__label">On hand</span>
      <span class="product-summary__value"><%= @product_on_hand_total %></span>
      <% if current_store.present? %>
        <span class="product-summary__note"><%= current_store.name %></span>
      <% end %>
    </div>
  <% end %>
</section>

<div class="product-columns">
  <section class="section surface">
    <h2 class="section__title">Identity</h2>
    <% if identity_rows.any? %>
      <%= render "shared/definition_list", rows: identity_rows %>
    <% end %>

    <% if publication_rows.any? || @product.bibliographic_provider.present? %>
      <h2 class="section__title">Publication</h2>
      <% if publication_rows.any? %>
        <%= render "shared/definition_list", rows: publication_rows %>
      <% end %>
      <% if @product.bibliographic_provider.present? %>
        <p class="product-provenance muted">
          <%= @product.bibliographic_provider %>
          · <%= @product.bibliographic_provider_key %>
          <% if @product.bibliographic_fetched_at.present? %>
            · fetched <%= format_timestamp(@product.bibliographic_fetched_at) %>
          <% end %>
        </p>
      <% end %>
    <% end %>

    <% if @product.description.present? %>
      <div class="product-description">
        <h3 class="section__title">Description</h3>
        <%= simple_format(@product.description) %>
      </div>
    <% end %>

    <% if can_refresh %>
      <div class="product-refresh">
        <h3 class="section__title">Refresh bibliographic data</h3>
        <p class="muted">Fetch a candidate and review each field before applying. Nothing is overwritten until you confirm.</p>
        <%= form_with url: refresh_bibliography_admin_product_path(@product), method: :post, class: "form" do |form| %>
          <div class="actions">
            <%= action_submit(form, "Review bibliographic update", style: :outline, intent: :neutral) %>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>

  <% if @recent_audit_events.present? %>
    <aside class="section surface">
      <h2 class="section__title">Recent activity</h2>
      <ul>
        <% @recent_audit_events.each do |event| %>
          <li>
            <%= format_timestamp(event.occurred_at) %> ·
            <%= event.action %> ·
            <%= event.outcome %> ·
            <%= event.actor_label %>
          </li>
        <% end %>
      </ul>
      <% if effective_permissions.include?("audit_events.view") %>
        <p><%= link_to "View audit events", admin_audit_events_path(subject_type: "Product") %></p>
      <% end %>
    </aside>
  <% end %>
</div>

<section class="section surface">
  <div class="product-section-head">
    <h2 class="section__title">Variants</h2>
    <% if effective_permissions.include?("product_variants.create") %>
      <div class="actions">
        <%= action_link_to(
              "New variant",
              new_admin_product_product_variant_path(@product),
              style: :solid,
              intent: :brand
            ) %>
      </div>
    <% end %>
  </div>

  <% if @product_variants.empty? %>
    <%= render "shared/empty_state",
          title: "No variants yet",
          body: "Add a standard or used variant to make this product sellable." %>
  <% else %>
    <% can_order = effective_permissions.include?("orders.manage") && current_store.present? %>
    <% can_request = effective_permissions.include?("customer_requests.manage") && current_store.present? %>
    <% rows = @product_variants.map { |variant|
         tracking = variant.derived_inventory_tracking
         on_hand_cell =
           if !@show_inventory
             nil
           elsif tracking.blank? || tracking == "non_inventory"
             "—"
           else
             balance = @balances_by_variant_id[variant.id]
             qty = balance&.on_hand_quantity || 0
             if balance
               admin_inventory_balance_link(balance, label: qty.to_s) || qty
             else
               qty
             end
           end
         purchasing_actions = []
         if can_order && stock_orderable_variant?(variant)
           purchasing_actions << link_to("Order stock", order_stock_path_for(variant))
         end
         if can_request && customer_requestable_variant?(variant, store: current_store)
           purchasing_actions << link_to("Request", create_customer_request_path_for(variant))
         end
         row = [
           link_to(variant.name.presence || "Unnamed", admin_product_variant_path(variant)),
           variant.sku,
           variant.variant_type.humanize,
           status_badge(variant.status, scheme: :product_variant),
           variant.merchandise_class ? variant.merchandise_class.admin_label : missing_value,
           variant.department ? variant.department.admin_label : missing_value,
           variant.effective_tax_class ? variant.effective_tax_class.admin_label : missing_value,
           variant.used? ? (variant.merchandise_condition&.name || missing_value) : "—",
           format_money_cents(variant.regular_price_cents)
         ]
         row << on_hand_cell if @show_inventory
         if can_order || can_request
           row << (purchasing_actions.empty? ? "—" : safe_join(purchasing_actions, " · "))
         end
         row
       } %>
    <% headers = [
         "Name", "SKU", "Type", "Status", "Class", "Department", "Tax", "Condition",
         { text: "Regular price", class: "numeric" }
       ] %>
    <% headers << { text: "On hand", class: "numeric" } if @show_inventory %>
    <% headers << "Purchasing" if can_order || can_request %>
    <%= render "shared/data_table",
          headers: headers,
          rows: rows %>
    <% if current_store.blank? && (effective_permissions.include?("orders.manage") || effective_permissions.include?("customer_requests.manage")) %>
      <p class="muted">Select a store to order stock or create customer requests from this product.</p>
    <% end %>
  <% end %>
</section>

<%= render "shared/technical_details", rows: [
      ["ID", @product.id],
      ["Created", format_timestamp(@product.created_at)],
      ["Updated", format_timestamp(@product.updated_at)],
      ["Lock version", @product.lock_version]
    ] %>
