<% content_for :title, "Review bibliographic data" %>

<%= render "shared/breadcrumbs", crumbs: [
  { name: "Home", path: root_path },
  { name: "Products", path: admin_products_path },
  { name: @product.name, path: admin_product_path(@product) },
  { name: "Review" }
] %>

<%= render "shared/page_header",
      title: "Review bibliographic data",
      subtitle: "Choose which candidate values to apply. Unselected fields stay unchanged." %>

<%= render "shared/form_errors", record: @product %>

<%= form_with url: apply_bibliography_admin_product_path(@product), method: :post, class: "form bibliographic-review" do |form| %>
  <%= hidden_field_tag :candidate_id, @candidate.candidate_id %>
  <%= hidden_field_tag "product[lock_version]", @product.lock_version %>

  <% @review_fields.each do |field| %>
    <fieldset class="bibliographic-review__field" id="review-<%= field[:key] %>">
      <legend><%= field[:label] %></legend>
      <div class="bibliographic-review__pair">
        <div class="bibliographic-review__current">
          <span class="bibliographic-review__label" id="current-<%= field[:key] %>-label">Current</span>
          <div id="current-<%= field[:key] %>"><%= field[:current].presence || "—" %></div>
        </div>
        <div class="bibliographic-review__proposed">
          <span class="bibliographic-review__label" id="proposed-<%= field[:key] %>-label">Proposed</span>
          <% if field[:key] == "contributions" %>
            <% rows = @candidate.contribution_rows %>
            <% rows += [ {} ] while rows.length < 2 %>
            <% rows.each_with_index do |row, index| %>
              <div class="form-field">
                <%= text_field_tag "proposed_contribution_rows[#{index}][display_name]", row["display_name"],
                      "aria-labelledby": "proposed-#{field[:key]}-label" %>
                <%= select_tag "proposed_contribution_rows[#{index}][role]",
                      options_for_select(ProductContribution::ROLES.map { |role| [ role.humanize, role ] }, row["role"] || "author") %>
              </div>
            <% end %>
          <% elsif field[:key] == "product_form" %>
            <%= select_tag "proposed[product_form]",
                  options_for_select(ProductForm.assignable.admin_ordered.map { |form| [ form.name, form.code ] }, field[:proposed_code] || @candidate.product_form_code),
                  include_blank: true,
                  "aria-labelledby": "proposed-#{field[:key]}-label" %>
          <% elsif field[:key] == "cover_image" %>
            <div id="proposed-<%= field[:key] %>"><%= field[:proposed].presence || "—" %></div>
          <% elsif field[:key] == "subjects" %>
            <div id="proposed-<%= field[:key] %>"><%= field[:proposed].presence || "—" %></div>
          <% else %>
            <%= text_field_tag "proposed[#{field[:key]}]", field[:proposed],
                  "aria-labelledby": "proposed-#{field[:key]}-label" %>
          <% end %>
        </div>
      </div>
      <div class="form-field">
        <label>
          <%= check_box_tag "selected_fields[]", field[:key], field[:default_apply], id: "apply-#{field[:key]}" %>
          Apply proposed <%= field[:label].downcase %>
        </label>
      </div>
    </fieldset>
  <% end %>

  <div class="actions">
    <%= action_submit(form, "Apply selected fields", style: :solid, intent: :brand) %>
    <%= action_link_to("Cancel", admin_product_path(@product), style: :ghost, intent: :neutral) %>
  </div>
<% end %>
