<% content_for :title, "Review bibliographic data" %>

<%= render "shared/breadcrumbs", crumbs: [
  { name: "Home", path: root_path },
  { name: "Products", path: admin_products_path },
  { name: @product.name, path: admin_product_path(@product) },
  { name: "Review" }
] %>

<%= render "shared/page_header",
      eyebrow: "Product",
      title: "Review bibliographic data",
      subtitle: "Choose which candidate values to apply. Unselected fields stay unchanged.",
      metadata: "#{@product.name} · Primary identifier #{@product.primary_identifier}" %>

<%= render "shared/form_errors", record: @product %>

<% review_families = [
     { title: "Identity", help: "Name and descriptive values.", keys: %w[name subtitle description brand_name product_model] },
     { title: "Identifiers", help: "Manufacturer identifier proposed by the candidate.", keys: %w[industry_identifier] },
     { title: "Publication", help: "Bookstore metadata, contributors, and subjects.", keys: %w[imprint product_form language_code page_count series_name series_position release_date contributions subjects] },
     { title: "Cover", help: "Cover remains a thumbnail on Product details after apply.", keys: %w[cover_image] },
     { title: "Pricing", help: "Product-level list price. Variant prices are not rewritten.", keys: %w[list_price_cents] }
   ] %>
<% fields_by_key = @review_fields.index_by { |field| field[:key].to_s } %>
<% assigned_keys = [] %>

<%= form_with url: apply_bibliography_admin_product_path(@product), method: :post, class: "form surface bibliographic-review" do |form| %>
  <%= hidden_field_tag :candidate_id, @candidate.candidate_id %>
  <%= hidden_field_tag "product[lock_version]", @product.lock_version %>

  <% review_families.each do |family| %>
    <% family_fields = family[:keys].filter_map { |key| fields_by_key[key] } %>
    <% next if family_fields.empty? %>
    <% assigned_keys.concat(family_fields.map { |field| field[:key].to_s }) %>
    <%= render layout: "shared/form_section", locals: { title: family[:title], help: family[:help] } do %>
      <% family_fields.each do |field| %>
        <%= render "bibliographic_review_field", field: field %>
      <% end %>
    <% end %>
  <% end %>

  <% leftover_fields = @review_fields.reject { |field| assigned_keys.include?(field[:key].to_s) } %>
  <% if leftover_fields.any? %>
    <%= render layout: "shared/form_section", locals: { title: "Other", help: "Fields not grouped with a family." } do %>
      <% leftover_fields.each do |field| %>
        <%= render "bibliographic_review_field", field: field %>
      <% end %>
    <% end %>
  <% end %>

  <div class="admin-form-footer">
    <%= action_link_to("Cancel", admin_product_path(@product), style: :ghost, intent: :neutral) %>
    <%= action_submit(form, "Apply selected fields", style: :solid, intent: :brand) %>
  </div>
<% end %>
