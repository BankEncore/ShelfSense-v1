<%= form_with model: [:admin, store], class: "form" do |form| %>
  <%= render "shared/form_errors", record: store %>
  <%= form.hidden_field :lock_version %>

  <%= render layout: "shared/form_section", locals: { title: "Identity" } do %>
    <div class="form-field">
      <%= form.label :store_number %>
      <% if store.persisted? && store.store_number_locked? %>
        <p><code><%= store.store_number %></code> (immutable after a receipt has been issued)</p>
      <% else %>
        <%= form.number_field :store_number, min: 1, step: 1 %>
      <% end %>
    </div>
    <div class="form-field">
      <%= form.label :code %>
      <%= form.text_field :code %>
    </div>
    <div class="form-field">
      <%= form.label :name %>
      <%= form.text_field :name %>
    </div>
    <div class="form-field">
      <%= form.label :legal_name, "Legal name" %>
      <%= form.text_field :legal_name %>
    </div>
    <div class="form-field">
      <%= form.label :phone %>
      <%= form.text_field :phone %>
    </div>
    <div class="form-field">
      <%= form.label :san, "SAN" %>
      <%= form.text_field :san %>
    </div>
  <% end %>

  <%= render layout: "shared/form_section", locals: { title: "Address" } do %>
    <div class="form-field">
      <%= form.label :street_address_1, "Street address 1" %>
      <%= form.text_field :street_address_1 %>
    </div>
    <div class="form-field">
      <%= form.label :street_address_2, "Street address 2" %>
      <%= form.text_field :street_address_2 %>
    </div>
    <div class="form-field">
      <%= form.label :city %>
      <%= form.text_field :city %>
    </div>
    <div class="form-field">
      <%= form.label :region_code, "Region" %>
      <%= form.text_field :region_code %>
    </div>
    <div class="form-field">
      <%= form.label :postal_code, "Postal code" %>
      <%= form.text_field :postal_code %>
    </div>
    <div class="form-field">
      <%= form.label :country_code, "Country code" %>
      <%= form.text_field :country_code %>
    </div>
    <div class="form-field">
      <%= form.label :timezone %>
      <%= form.text_field :timezone %>
    </div>
  <% end %>

  <%= render layout: "shared/form_section", locals: { title: "Cash thresholds", help: "Leave blank to inherit the organization default. Comparisons are inclusive (>=) on the absolute variance or paid-out amount." } do %>
    <div class="form-field">
      <%= form.label :cash_variance_note_threshold_cents, "Variance note threshold (cents)" %>
      <%= form.number_field :cash_variance_note_threshold_cents, min: 0 %>
    </div>
    <div class="form-field">
      <%= form.label :cash_variance_approval_threshold_cents, "Variance approval threshold (cents)" %>
      <%= form.number_field :cash_variance_approval_threshold_cents, min: 0 %>
    </div>
    <div class="form-field">
      <%= form.label :cash_paid_out_approval_threshold_cents, "Paid-out approval threshold (cents)" %>
      <%= form.number_field :cash_paid_out_approval_threshold_cents, min: 0 %>
    </div>
  <% end %>

  <%= render layout: "shared/form_section", locals: { title: "Receipt messages", help: "Plain text only. Messages wrap to receipt width and are not a template language. Custom text is kept when you switch away from custom mode." } do %>
    <% settings = SystemSettings.current %>
    <div data-store-receipt-messages>
      <fieldset class="form-field">
        <legend>Receipt header</legend>
        <label>
          <%= form.radio_button :receipt_header_mode, "inherit", data: { receipt_message: "header-mode" } %>
          Use organization default
        </label>
        <p class="muted">
          Effective default:
          <%= settings.default_receipt_header.present? ? settings.default_receipt_header : "(no organization default)" %>
        </p>
        <label>
          <%= form.radio_button :receipt_header_mode, "custom", data: { receipt_message: "header-mode" } %>
          Use custom header
        </label>
        <%= form.text_area :receipt_header, rows: 3, maxlength: Store::RECEIPT_MESSAGE_LIMIT,
              disabled: store.receipt_header_mode != "custom",
              data: { receipt_message: "header" } %>
        <label>
          <%= form.radio_button :receipt_header_mode, "none", data: { receipt_message: "header-mode" } %>
          Do not print a header message
        </label>
      </fieldset>
      <fieldset class="form-field">
        <legend>Receipt footer</legend>
        <label>
          <%= form.radio_button :receipt_footer_mode, "inherit", data: { receipt_message: "footer-mode" } %>
          Use organization default
        </label>
        <p class="muted">
          Effective default:
          <%= settings.default_receipt_footer.present? ? settings.default_receipt_footer : "(no organization default)" %>
        </p>
        <label>
          <%= form.radio_button :receipt_footer_mode, "custom", data: { receipt_message: "footer-mode" } %>
          Use custom footer
        </label>
        <%= form.text_area :receipt_footer, rows: 3, maxlength: Store::RECEIPT_MESSAGE_LIMIT,
              disabled: store.receipt_footer_mode != "custom",
              data: { receipt_message: "footer" } %>
        <label>
          <%= form.radio_button :receipt_footer_mode, "none", data: { receipt_message: "footer-mode" } %>
          Do not print a footer message
        </label>
      </fieldset>
    </div>
  <% end %>

  <div class="actions">
    <%= action_submit(
          form,
          store.persisted? ? "Save Changes" : "Create Store",
          style: :solid,
          intent: :brand
        ) %>
    <%= action_link_to(
          "Cancel",
          store.persisted? ? admin_store_path(store) : admin_stores_path,
          style: :ghost,
          intent: :neutral
        ) %>
  </div>
<% end %>
