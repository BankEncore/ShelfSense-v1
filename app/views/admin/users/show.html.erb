<% content_for :title, @user.username %>
<h1><%= @user.display_name %></h1>
<p>Username: <%= @user.username %></p>
<p>Email: <%= @user.email %></p>
<p>
  <%= action_link_to("Edit", edit_admin_user_path(@user), style: :outline, intent: :neutral) if effective_permissions.include?("users.manage") %>
  <% if effective_permissions.include?("users.manage") && @user.active? %>
    <%= action_button_to("Reset password", reset_password_admin_user_path(@user), style: :outline, intent: :warning, method: :post) %>
  <% end %>
  <% if effective_permissions.include?("users.deactivate") && @user.active? && !@user.system_actor? %>
    <%= action_button_to("Deactivate", deactivate_admin_user_path(@user), style: :outline, intent: :warning, method: :post) %>
  <% end %>
</p>
