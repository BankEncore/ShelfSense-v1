<% content_for :title, "Customers" %>

<%= render "shared/breadcrumbs", crumbs: [
  { name: "Home", path: root_path },
  { name: "Customers" }
] %>

<% header_actions = nil %>
<% if effective_permissions.include?("customers.manage") %>
  <% header_actions = action_link_to("New customer", new_admin_customer_path, style: :solid, intent: :brand) %>
<% end %>

<%= render "shared/page_header", title: "Customers", actions: header_actions %>

<%= form_with url: admin_customers_path, method: :get, local: true, class: "filters" do |form| %>
  <div class="form-field">
    <%= label_tag :q, "Search" %>
    <%= text_field_tag :q, @q, placeholder: "Name, email, or phone" %>
  </div>
  <div class="form-field">
    <%= label_tag :lifecycle, "Show" %>
    <%= select_tag :lifecycle,
          options_for_select(
            [
              [ "Canonical customers", "canonical" ],
              [ "All including merged aliases", "all" ],
              [ "Merged aliases only", "merged" ]
            ],
            @lifecycle
          ) %>
  </div>
  <div class="form-field">
    <%= action_submit(form, "Search", style: :solid, intent: :brand) %>
  </div>
<% end %>

<% rows = @customers.map { |customer|
     status = if customer.merged?
       "Merged"
     elsif customer.active?
       configuration_status_badge(true)
     else
       configuration_status_badge(false)
     end
     former = @search_results&.find { |r| r.customer.id == customer.id }&.matched_former_customer
     name_cell = link_to(customer.admin_label, admin_customer_path(customer))
     name_cell = safe_join([name_cell, tag.span(" (matched former record)", class: "muted")], "") if former
     [
       name_cell,
       customer.email.presence || missing_value,
       customer.phone.presence || missing_value,
       status
     ]
   } %>
<%= render "shared/data_table",
      headers: ["Name", "Email", "Phone", "Status"],
      rows: rows,
      empty: render("shared/empty_state",
                    title: (@q.present? ? "No matching customers" : "No customers yet"),
                    body: (@q.present? ? "Try a different name, email, or phone." : "Create a customer to attach requests and contact details.")) %>
