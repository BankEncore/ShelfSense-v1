<%= form_with model: [:admin, customer], class: "form" do |form| %>
  <%= hidden_field_tag :return_to, @return_to if @return_to.present? %>
  <%= render "shared/form_errors", record: customer %>
  <%= form.hidden_field :lock_version %>

  <div class="form-field">
    <%= form.label :given_name, "Given name" %>
    <%= form.text_field :given_name, autofocus: !customer.persisted? %>
  </div>
  <div class="form-field">
    <%= form.label :family_name, "Family name" %>
    <%= form.text_field :family_name %>
  </div>
  <div class="form-field">
    <%= form.label :display_name, "Display name" %>
    <%= form.text_field :display_name,
          placeholder: "Defaults to Family, Given when blank",
          autofocus: customer.persisted? %>
    <p class="muted">Leave blank to use Family, Given from the name fields above.</p>
  </div>
  <div class="form-field">
    <%= form.label :email %>
    <%= form.email_field :email %>
  </div>
  <div class="form-field">
    <%= form.label :phone %>
    <%= form.telephone_field :phone %>
  </div>
  <div class="form-field">
    <%= form.label :preferred_contact_method, "Preferred contact" %>
    <%= form.select :preferred_contact_method,
          Customer::PREFERRED_CONTACT_METHODS.map { |m| [m.titleize, m] } %>
  </div>
  <div class="form-field">
    <%= form.label :notes %>
    <%= form.text_area :notes %>
  </div>

  <% if @duplicate_suggestions.present? %>
    <section class="section surface" aria-label="Possible duplicate customers">
      <h2 class="section__title">Possible duplicates</h2>
      <p>Review these matches before saving. Use an existing customer, or confirm you still want to continue.</p>
      <ul>
        <% @duplicate_suggestions.each do |suggestion| %>
          <li>
            <%= link_to suggestion.customer.admin_label, admin_customer_path(suggestion.customer) %>
            — <%= suggestion.match_strength %> match on <%= suggestion.matched_on %>
            (<%= suggestion.customer.email.presence || suggestion.customer.phone.presence || "no contact" %>)
          </li>
        <% end %>
      </ul>
      <div class="form-field">
        <label>
          <%= check_box_tag :acknowledge_duplicates, "1", false %>
          Create / save anyway despite possible duplicates
        </label>
      </div>
    </section>
  <% end %>

  <div class="actions">
    <%= action_submit(
          form,
          customer.persisted? ? "Save Changes" : "Create Customer",
          style: :solid,
          intent: :brand
        ) %>
    <%= action_link_to(
          "Cancel",
          if @return_to.present?
            @return_to
          elsif customer.persisted?
            admin_customer_path(customer)
          else
            admin_customers_path
          end,
          style: :ghost,
          intent: :neutral
        ) %>
  </div>
<% end %>
