<% content_for :title, @customer.admin_label %>

<% lifecycle = if @customer.merged?
     "Merged"
   elsif @customer.active?
     configuration_status_badge(true)
   else
     configuration_status_badge(false)
   end %>
<% actions = [lifecycle] %>
<% if effective_permissions.include?("customers.manage") && !@customer.merged? %>
  <% actions << action_link_to("Edit", edit_admin_customer_path(@customer), style: :outline, intent: :neutral) %>
  <% if @customer.active? %>
    <% actions << action_button_to(
         "Deactivate",
         admin_customer_path(@customer),
         style: :outline,
         intent: :warning,
         method: :delete
       ) %>
  <% else %>
    <% actions << action_button_to(
         "Reactivate",
         reactivate_admin_customer_path(@customer),
         style: :solid,
         intent: :brand,
         method: :post
       ) %>
  <% end %>
<% end %>

<%= render layout: "admin/shared/page", locals: {
  width: :standard,
  title: @customer.admin_label,
  crumbs: [
    { name: "Home", path: root_path },
    { name: "Customers", path: admin_customers_path },
    { name: @customer.admin_label }
  ],
  actions: safe_join(actions, " ")
} do %>
  <% if @customer.merged? %>
    <section class="section surface" role="status">
      <p>
        This customer was merged into
        <%= link_to @customer.merged_into_customer.admin_label, admin_customer_path(@customer.merged_into_customer) %>.
        It is retained as a historical alias and cannot be used for new operational work.
      </p>
    </section>
  <% end %>

  <section class="section surface">
    <%= render "shared/definition_list", rows: [
          ["Given name", @customer.given_name],
          ["Family name", @customer.family_name],
          ["Email", @customer.email],
          ["Phone", @customer.phone],
          ["Preferred contact", @customer.preferred_contact_method&.titleize],
          ["Notes", (@customer.notes.present? ? simple_format(@customer.notes) : nil)],
          ["Status", lifecycle]
        ] %>
  </section>

  <% if @customer.canonical? && @merged_aliases.present? %>
    <section class="section">
      <h2 class="section__title">Merged aliases</h2>
      <% rows = @merged_aliases.map { |alias_customer|
           [
             link_to(alias_customer.admin_label, admin_customer_path(alias_customer)),
             alias_customer.email.presence || missing_value,
             alias_customer.phone.presence || missing_value
           ]
         } %>
      <%= render "shared/data_table", headers: ["Name", "Email", "Phone"], rows: rows %>
    </section>
  <% end %>

  <% if effective_permissions.include?("customers.manage") && @customer.canonical? && @customer.active? %>
    <section class="section surface">
      <h2 class="section__title">Merge into another customer</h2>
      <p>Choose the surviving customer. This customer will become a read-only alias.</p>
      <%= form_with url: merge_review_admin_customer_path(@customer), method: :get, local: true, class: "form" do %>
        <div class="form-field">
          <%= label_tag :survivor_id, "Survivor customer ID" %>
          <%= text_field_tag :survivor_id, params[:survivor_id], required: true %>
        </div>
        <div class="actions">
          <%= submit_tag "Review merge", class: "button button--solid button--brand" %>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if @stored_value_accounts %>
    <section class="section surface">
      <h2 class="section__title">Stored value</h2>
      <% if @stored_value_accounts.any? %>
        <% rows = @stored_value_accounts.map { |account|
             actions = []
             if effective_permissions.include?("stored_value.adjust") && @customer.active? && account.active?
               actions << action_link_to("Adjust", new_admin_customer_stored_value_adjustment_path(@customer, stored_value_account_id: account.id), style: :outline, intent: :neutral)
             end
             [
               account.account_type.humanize,
               format_money_cents(account.balance_cents),
               account.status.humanize,
               safe_join(actions, " ")
             ]
           } %>
        <%= render "shared/data_table", headers: ["Type", "Balance", "Status", ""], rows: rows %>
      <% else %>
        <%= render "shared/empty_state", title: "No stored-value accounts", body: "Store credit and trade credit are created when value is posted." %>
      <% end %>
      <% if effective_permissions.include?("stored_value.adjust") && @customer.canonical? && @customer.active? %>
        <div class="actions">
          <%= action_link_to("Add store credit", new_admin_customer_stored_value_adjustment_path(@customer, account_type: "store_credit"), style: :solid, intent: :brand) %>
          <%= action_link_to("Add trade credit", new_admin_customer_stored_value_adjustment_path(@customer, account_type: "trade_credit"), style: :outline, intent: :neutral) %>
        </div>
      <% end %>
      <% if effective_permissions.include?("stored_value.transfer") && @customer.canonical? && @customer.active? %>
        <div class="actions">
          <%= action_link_to("Transfer credit", new_admin_stored_value_transfer_path(from_customer_id: @customer.id), style: :outline, intent: :neutral) %>
        </div>
      <% end %>
    </section>
  <% end %>

  <% if @stored_value_activities.present? %>
    <% @stored_value_activities.each do |account, activity| %>
      <section class="section">
        <h2 class="section__title"><%= account.account_type.humanize %> activity</h2>
        <%= render "admin/stored_value/account_activity",
              activity: activity,
              show_card: false,
              page_path: ->(page) {
                other = (@stored_value_activities.keys - [account]).to_h { |other_account|
                  [other_account.id, @stored_value_activities[other_account].page]
                }
                admin_customer_path(@customer, activity_page: other.merge(account.id => page))
              } %>
      </section>
    <% end %>
  <% end %>

  <% if @associated_gift_cards %>
    <section class="section surface">
      <h2 class="section__title">Associated gift cards</h2>
      <% if @associated_gift_cards.any? %>
        <% rows = @associated_gift_cards.map { |card|
             [
               link_to(card.masked_number, admin_gift_card_path(card)),
               card.status.humanize,
               format_money_cents(card.balance_cents)
             ]
           } %>
        <%= render "shared/data_table", headers: ["Card", "Status", "Balance"], rows: rows %>
      <% else %>
        <%= render "shared/empty_state", title: "No associated gift cards", body: "Optional association does not transfer ownership of the balance." %>
      <% end %>
    </section>
  <% end %>

  <section class="section">
    <h2 class="section__title">Recent requests</h2>
    <% if effective_permissions.include?("customer_requests.manage") && @customer.canonical? && @customer.active? %>
      <div class="actions">
        <%= action_link_to(
              "New request",
              new_admin_customer_request_path(customer_id: @customer.id),
              style: :solid,
              intent: :brand
            ) %>
      </div>
    <% end %>

    <% if @customer_requests.any? %>
      <% rows = @customer_requests.map { |request|
           [
             admin_customer_request_cross_link(request, label: "Request ##{request.number}") || "Request ##{request.number}",
             request.status,
             request.store.admin_label
           ]
         } %>
      <%= render "shared/data_table",
            headers: ["Request", "Status", "Store"],
            rows: rows %>
    <% else %>
      <%= render "shared/empty_state",
            title: "No requests yet",
            body: "Create a request when this customer needs merchandise located or ordered." %>
    <% end %>
  </section>

  <p>
    <%= action_link_to("Back to customers", admin_customers_path, style: :link, intent: :neutral) %>
  </p>
<% end %>
