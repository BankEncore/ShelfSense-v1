<% content_for :title, @customer.admin_label %>
<h1><%= @customer.admin_label %></h1>
<p>
  <% if effective_permissions.include?("customers.manage") %>
    <%= link_to "Edit", edit_admin_customer_path(@customer) %>
    <% if @customer.active? %>
      <%= button_to "Deactivate", admin_customer_path(@customer), method: :delete %>
    <% else %>
      <%= button_to "Reactivate", reactivate_admin_customer_path(@customer), method: :post %>
    <% end %>
  <% end %>
  <%= link_to "Back", admin_customers_path %>
</p>
<dl>
  <dt>Email</dt><dd><%= @customer.email.presence || "—" %></dd>
  <dt>Phone</dt><dd><%= @customer.phone.presence || "—" %></dd>
  <dt>Notes</dt><dd><%= simple_format(@customer.notes.presence || "—") %></dd>
  <dt>Status</dt><dd><%= @customer.active? ? "active" : "inactive" %></dd>
</dl>

<h2>Recent requests</h2>
<% if effective_permissions.include?("customer_requests.manage") %>
  <p><%= link_to "New request", new_admin_customer_request_path(customer_id: @customer.id) %></p>
<% end %>
<ul>
  <% @customer_requests.each do |request| %>
    <li>
      <%= link_to "Request ##{request.number}", admin_customer_request_path(request) %>
      — <%= request.status %> — <%= request.store.admin_label %>
    </li>
  <% end %>
</ul>
