<% content_for :title, @merchandise_category.admin_label %>
<h1><%= @merchandise_category.admin_label %></h1>
<p>
  Parent: <%= @merchandise_category.parent&.admin_label || "—" %> ·
  Default standard class: <%= @merchandise_category.default_standard_merchandise_class&.admin_label || "—" %> ·
  Default used class: <%= @merchandise_category.default_used_merchandise_class&.admin_label || "—" %> ·
  Order: <%= @merchandise_category.display_order %> ·
  <%= @merchandise_category.active? ? "active" : "inactive" %>
</p>
<% if @merchandise_category.description.present? %><p><%= @merchandise_category.description %></p><% end %>
<p>
  <%= action_link_to("Edit", edit_admin_merchandise_category_path(@merchandise_category), style: :outline, intent: :neutral) if effective_permissions.include?("merchandise_categories.update") %>
  <% if effective_permissions.include?("merchandise_categories.deactivate") && @merchandise_category.active? %>
    <%= action_button_to(
          "Deactivate",
          admin_merchandise_category_path(@merchandise_category),
          style: :outline,
          intent: :warning,
          method: :delete,
          form: { data: { turbo_confirm: "Deactivate this category?" } }
        ) %>
  <% elsif effective_permissions.include?("merchandise_categories.deactivate") && !@merchandise_category.active? %>
    <%= action_button_to(
          "Reactivate",
          reactivate_admin_merchandise_category_path(@merchandise_category),
          style: :solid,
          intent: :brand,
          method: :post,
          params: { lock_version: @merchandise_category.lock_version }
        ) %>
  <% end %>
</p>
<p><%= action_link_to("Back to categories", admin_merchandise_categories_path, style: :link, intent: :neutral) %></p>
