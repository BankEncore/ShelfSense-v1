<% content_for :title, "Merchandise Categories" %>
<h1>Merchandise Categories</h1>
<% if effective_permissions.include?("merchandise_categories.create") %><p><%= link_to "New category", new_admin_merchandise_category_path %></p><% end %>
<% if @merchandise_categories.empty? %>
  <p>No merchandise categories yet.</p>
<% else %>
  <ul class="hierarchy-list">
    <% MerchandiseCategory.hierarchical_entries(@merchandise_categories).each do |category, depth| %>
      <li style="<%= "margin-left: #{depth * 1.25}rem" if depth.positive? %>">
        <%= link_to category.admin_label, admin_merchandise_category_path(category) %>
        <%= "inactive" unless category.active? %>
      </li>
    <% end %>
  </ul>
<% end %>
