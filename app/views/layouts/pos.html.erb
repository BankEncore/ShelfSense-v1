<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{content_for(:title)} · ShelfSense" : "Register · ShelfSense" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= render "pos/receipts/thermal_fonts" %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags "pos" %>
  </head>
  <body class="pos-body density-standard">
    <span class="pos-receipt-font-loader pos-no-print" aria-hidden="true">0</span>
    <%= yield %>
  </body>
</html>
