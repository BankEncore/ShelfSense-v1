<!DOCTYPE html>
<html lang="en" data-turbo="false">
  <head>
    <title><%= content_for?(:title) ? "#{content_for(:title)} · ShelfSense" : "ShelfSense" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "application" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="density-compact">
    <div class="app-shell">
      <%= render "shared/flash" %>

      <% if signed_in? %>
        <header class="app-header">
          <div>
            <%= link_to "ShelfSense", root_path, class: "app-brand" %>
            <% if current_store.present? %>
              <div class="app-header-meta">Current store: <%= current_store.admin_label %></div>
            <% end %>
          </div>
          <%= render "shared/admin_primary_nav" %>
        </header>
      <% end %>

      <main class="app-content">
        <%= yield %>
      </main>
    </div>
  </body>
</html>
